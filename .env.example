# ==============================================================================
# EECC Ecosystem - Template des variables d'environnement
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Backend & Base de données)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clé privilégiée strictement réservée aux Edge Functions / Serveur (Ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Maishapay (serveur uniquement : ne pas préfixer par NEXT_PUBLIC ni VITE)
# ------------------------------------------------------------------------------
# Le fichier réel est .env à la racine du dépôt, ou apps/web_portal/.env.local.
# Next.js ne charge pas automatiquement le .env de la racine : la route /api/don le lit.
# Sandbox : préfixes MP-SBPK- et MP-SBSK-, gatewayMode 0.
# Live : préfixes MP-LIVEPK- et MP-LIVESK-. Cette version refuse de les envoyer.
MAISHAPAY_PUBLIC_KEY=MP-SBPK-remplacer
MAISHAPAY_SECRET_KEY=MP-SBSK-remplacer
MAISHAPAY_WEBHOOK_SECRET=remplacer-par-le-secret-de-callback

# ------------------------------------------------------------------------------
# 3. Brevo (E-mails transactionnels & Envoi des OTP 5 caractères)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=kandedan28@gmail.com
BREVO_SENDER_NAME="Sécurité Trésorerie EECC"

# ------------------------------------------------------------------------------
# 4. Supabase Storage (Stockage des podcasts, audios et documents)
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_PODCASTS_BUCKET=podcasts
SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
SUPABASE_STORAGE_RAW_MEDIA_BUCKET=raw-media

# ------------------------------------------------------------------------------
# 5. Sécurité Trésorerie & OTP (Section 20 du cahier des charges)
# ------------------------------------------------------------------------------
TREASURY_OTP_EXPIRY_MINUTES=5
TREASURY_OTP_MAX_ATTEMPTS=5
TREASURY_SECURITY_EMAIL=admin-finance@eecc-eglise.org
