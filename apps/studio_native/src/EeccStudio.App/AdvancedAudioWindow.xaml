<Window x:Class="EeccStudio.AdvancedAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Propriétés audio avancées"
        Height="460" Width="760"
        MinHeight="360" MinWidth="640"
        Background="#202225"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Mixage du programme. L'écoute seule retire la piste de l'antenne. Le délai aligne l'image et le son."
                   Foreground="#8E9297" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fermer" Width="100" Height="28" Click="Close_Click"
                    Background="#36393F" Foreground="White" BorderBrush="#2E3136"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>
    </DockPanel>
</Window>
