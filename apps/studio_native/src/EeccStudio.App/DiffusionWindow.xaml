<Window x:Class="EeccStudio.DiffusionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Démarrer la diffusion — EECC Studio"
        Height="720" Width="760"
        MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#14151C"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="CHOISIR LA DIFFUSION" FontWeight="Black" FontSize="16" Foreground="#FFFFFF"/>
            <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="12" Margin="0,6,0,0"
                       Text="EECC TV est toujours une destination. Le direct ne démarre pas tant que ce choix n'est pas confirmé. Aucune clé n'est affichée en clair."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Mode" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,8"/>
                <RadioButton x:Name="RbMode1" GroupName="Mode" IsChecked="True" Foreground="#F0F6FC" Margin="0,0,0,6"
                             Content="1 — EECC TV seule" Checked="Mode_Checked"/>
                <RadioButton x:Name="RbMode2" GroupName="Mode" Foreground="#F0F6FC" Margin="0,0,0,6"
                             Content="2 — EECC TV + une plateforme externe (Facebook, YouTube ou autre)" Checked="Mode_Checked"/>
                <RadioButton x:Name="RbMode3" GroupName="Mode" Foreground="#F0F6FC" Margin="0,0,0,12"
                             Content="3 — EECC TV + trois plateformes externes ou plus" Checked="Mode_Checked"/>

                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="EECC TV" Foreground="#16A34A" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTvUrl" TextWrapping="Wrap" Foreground="#F0F6FC" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="PanelExternalHeader" Margin="0,0,0,8">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="BtnAdd" Content="Ajouter une destination" DockPanel.Dock="Right"
                                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="10,4" Click="BtnAdd_Click"/>
                        <TextBlock Text="Destinations externes" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="11" Margin="0,0,0,8"
                               Text="Chaque adresse externe reçoit séparément l'image du programme au moment où cette destination démarre, puis cette image est répétée. EECC TV continue de lire l'image courante. Une panne externe n'arrête pas EECC TV. Le mixage audio n'est pas encore relié : la piste externe est silencieuse. YouTube, Facebook et TikTok ne sont pas déclarés compatibles sans essai chez le fournisseur. TikTok exige en plus un accès Live et une clé délivrée par TikTok."/>
                    <StackPanel x:Name="PanelExternals"/>
                    <CheckBox x:Name="ChkPublic" Foreground="#F0F6FC" Margin="0,8,0,0"
                              Content="J'autorise une adresse hors du réseau local. Les tests de cette version ne contactent pas ces services."/>
                </StackPanel>

                <TextBlock x:Name="TxtValidation" TextWrapping="Wrap" Foreground="#FBBF24" FontSize="12" Margin="0,8,0,4"/>
                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="#F0F6FC" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="Annuler" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="16,8" Click="BtnCancel_Click"/>
            <Button x:Name="BtnStart" Content="Démarrer" HorizontalAlignment="Right"
                    Background="#1877F2" Foreground="#FFFFFF" BorderThickness="0" Padding="16,8" FontWeight="Bold" Click="BtnStart_Click"/>
        </DockPanel>
    </Grid>
</Window>
