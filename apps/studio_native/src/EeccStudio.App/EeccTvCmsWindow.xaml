<Window x:Class="EeccStudio.EeccTvCmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EECC TV — Publication"
        Height="780" Width="1080"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#14151C"
        Foreground="#F0F6FC"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Style des Boutons d'Action OBS -->
        <Style x:Key="ObsActionButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ObsPrimaryButton" TargetType="Button" BasedOn="{StaticResource ObsActionButton}">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
        </Style>

        <Style x:Key="ObsDangerButton" TargetType="Button" BasedOn="{StaticResource ObsActionButton}">
            <Setter Property="Background" Value="#DA3633"/>
            <Setter Property="BorderBrush" Value="#F85149"/>
        </Style>

        <Style x:Key="ObsWarningButton" TargetType="Button" BasedOn="{StaticResource ObsActionButton}">
            <Setter Property="Background" Value="#9E6A03"/>
            <Setter Property="BorderBrush" Value="#D29922"/>
        </Style>

        <!-- Style des Onglets OBS -->
        <Style x:Key="ObsTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Style DataGrid OBS Dark -->
        <Style x:Key="ObsDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161B22"/>
            <Setter Property="AlternatingRowBackground" Value="#0D1117"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#21262D"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1C2128"/>
                        <Setter Property="Foreground" Value="#C9D1D9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#30363D"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- En-tête -->
            <RowDefinition Height="*"/>    <!-- Contenu Tabs -->
            <RowDefinition Height="Auto"/> <!-- Pied de page et barre de statut -->
        </Grid.RowDefinitions>

        <!-- 0. En-tête -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshAll" Content="Actualiser" Style="{StaticResource ObsActionButton}" Click="BtnRefreshAll_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="EECC TV — Publication" FontWeight="SemiBold" FontSize="20" Foreground="#FFFFFF"/>
                    <TextBlock Text="Le direct est écrit dans Supabase. Les fidèles le voient dans EECC TV. Les autres onglets publient podcasts, clips, textes et affiches."
                               Foreground="#8E9297" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Conteneur à Onglets -->
        <TabControl Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" Padding="4">

            <TabItem Header="Direct" Style="{StaticResource ObsTabItem}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="CULTE EN DIRECT" FontSize="11" FontWeight="Bold" Foreground="#E03232"/>
                            <TextBlock Text="Publier sur EECC TV" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,8"/>
                            <TextBlock Text="Le téléphone des fidèles lit cette adresse dans Supabase. Elle doit être joignable depuis leur réseau, en général le Wi-Fi de l'église."
                                       Foreground="#8E9297" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <TextBlock Text="Titre du culte" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLiveTitle" Padding="8,6" Margin="0,0,0,12" Background="#0D1117" Foreground="White" BorderBrush="#30363D" TextChanged="LiveCaption_TextChanged"/>
                            <TextBlock Text="Orateur" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLiveSpeaker" Padding="8,6" Margin="0,0,0,12" Background="#0D1117" Foreground="White" BorderBrush="#30363D" TextChanged="LiveCaption_TextChanged"/>
                            <TextBlock Text="Adresse du flux" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLiveUrl" Padding="8,6" Margin="0,0,0,18" Background="#0D1117" Foreground="White" BorderBrush="#30363D"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mettre en direct" Style="{StaticResource ObsPrimaryButton}" Click="BtnPublishLive_Click"/>
                                <Button Content="Terminer le direct" Style="{StaticResource ObsDangerButton}" Click="BtnEndLive_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLiveResult" Margin="0,16,0,0" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="16,0,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ce que voit EECC TV" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="1. Le titre et l'orateur." Margin="0,12,0,0" Foreground="#8E9297" TextWrapping="Wrap"/>
                            <TextBlock Text="2. Le badge En direct." Margin="0,8,0,0" Foreground="#8E9297" TextWrapping="Wrap"/>
                            <TextBlock Text="3. L'image du programme Studio, image par image." Margin="0,8,0,0" Foreground="#8E9297" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtLiveState" Text="Hors ligne" Margin="0,18,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#8E9297"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ONGLET 1 : PODCASTS CULTES -->
            <TabItem Header="Podcasts" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewPodcast" Content="Nouveau podcast" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewPodcast_Click"/>
                            <Button x:Name="BtnTogglePodcast" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnTogglePodcast_Click"/>
                            <Button x:Name="BtnDeletePodcast" Content="Supprimer" Style="{StaticResource ObsDangerButton}" Click="BtnDeletePodcast_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPodcastCount" Text="1 épisode" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="GridPodcasts" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Titre" Binding="{Binding Title}" Width="250"/>
                            <DataGridTextColumn Header="Prédicateur" Binding="{Binding Speaker}" Width="180"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="110"/>
                            <DataGridTextColumn Header="Durée" Binding="{Binding DurationFormatted}" Width="90"/>
                            <DataGridTextColumn Header="URL Audio" Binding="{Binding AudioUrl}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 2 : RÉSUMÉS AUDIOS -->
            <TabItem Header="Capsules audio" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewAudioSummary" Content="Nouvelle capsule" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewAudioSummary_Click"/>
                            <Button x:Name="BtnToggleAudioSummary" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnToggleAudioSummary_Click"/>
                            <Button x:Name="BtnDeleteAudioSummary" Content="Supprimer" Style="{StaticResource ObsDangerButton}" Click="BtnDeleteAudioSummary_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtAudioSummaryCount" Text="1 capsule" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="GridAudioSummaries" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Titre de la capsule" Binding="{Binding Title}" Width="250"/>
                            <DataGridTextColumn Header="Orateur" Binding="{Binding Speaker}" Width="160"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="110"/>
                            <DataGridTextColumn Header="Durée" Binding="{Binding DurationFormatted}" Width="80"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 3 : PETITES VIDÉOS (SHORTS / REELS) -->
            <TabItem Header="Clips" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewShortVideo" Content="Nouveau clip" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewShortVideo_Click"/>
                            <Button x:Name="BtnToggleShortVideo" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnToggleShortVideo_Click"/>
                            <Button x:Name="BtnDeleteShortVideo" Content="Supprimer" Style="{StaticResource ObsDangerButton}" Click="BtnDeleteShortVideo_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtShortVideoCount" Text="1 clip" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="GridShortVideos" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Titre du clip" Binding="{Binding Title}" Width="220"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding AspectRatio}" Width="80"/>
                            <DataGridTextColumn Header="Durée" Binding="{Binding DurationFormatted}" Width="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="110"/>
                            <DataGridTextColumn Header="URL Vidéo" Binding="{Binding VideoUrl}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 4 : RÉSUMÉS TEXTES PRÉDICATIONS -->
            <TabItem Header="Textes" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewSermonText" Content="Nouveau texte" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewSermonText_Click"/>
                            <Button x:Name="BtnToggleSermonText" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnToggleSermonText_Click"/>
                            <Button x:Name="BtnDeleteSermonText" Content="Supprimer" Style="{StaticResource ObsDangerButton}" Click="BtnDeleteSermonText_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSermonTextCount" Text="1 résumé" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="GridSermonTexts" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Titre de la prédication" Binding="{Binding Title}" Width="240"/>
                            <DataGridTextColumn Header="Prédicateur" Binding="{Binding Speaker}" Width="160"/>
                            <DataGridTextColumn Header="Thème" Binding="{Binding Theme}" Width="160"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="110"/>
                            <DataGridTextColumn Header="Versets clés" Binding="{Binding ScriptureRefs}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 5 : AFFICHES & ÉVÉNEMENTS (IMAGE UNIQUE) -->
            <TabItem Header="Affiches" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewBanner" Content="Publier une affiche" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewBanner_Click"/>
                            <Button x:Name="BtnToggleBanner" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnToggleBanner_Click"/>
                            <Button x:Name="BtnDeleteBanner" Content="Supprimer" Style="{StaticResource ObsDangerButton}" Click="BtnDeleteBanner_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBannerCount" Text="1 affiche" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="GridBanners" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Titre de l'événement" Binding="{Binding Title}" Width="240"/>
                            <DataGridTextColumn Header="Sous-titre / Date" Binding="{Binding Subtitle}" Width="220"/>
                            <DataGridTextColumn Header="Ordre" Binding="{Binding DisplayOrder}" Width="70"/>
                            <DataGridTextColumn Header="URL Image" Binding="{Binding ImageUrl}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 6 : GALERIES PHOTOS CULTES (JUSQU'À 200 IMAGES) -->
            <TabItem Header="Galeries" Style="{StaticResource ObsTabItem}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnNewAlbum" Content="Créer un album" Style="{StaticResource ObsPrimaryButton}" Click="BtnNewAlbum_Click"/>
                            <Button x:Name="BtnUploadBatchPhotos" Content="Ajouter des photos" Style="{StaticResource ObsActionButton}" Click="BtnUploadBatchPhotos_Click"/>
                            <Button x:Name="BtnToggleAlbum" Content="Masquer ou afficher" Style="{StaticResource ObsWarningButton}" Click="BtnToggleAlbum_Click"/>
                            <Button x:Name="BtnDeleteAlbum" Content="Supprimer l'album" Style="{StaticResource ObsDangerButton}" Click="BtnDeleteAlbum_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtAlbumCount" Text="1 album" Foreground="#8B949E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid x:Name="GridAlbums" Grid.Row="1" Style="{StaticResource ObsDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Statut" Binding="{Binding IsPublishedText}" Width="150"/>
                            <DataGridTextColumn Header="Nom de l'Album" Binding="{Binding Title}" Width="260"/>
                            <DataGridTextColumn Header="Date du Culte" Binding="{Binding DateFormatted}" Width="110"/>
                            <DataGridTextColumn Header="Nombre de Photos" Binding="{Binding PhotoCountFormatted}" Width="130"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Barre de progression d'upload par lot -->
                    <Border x:Name="PanelBatchProgress" Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="TxtBatchFileName" Text="Envoi de la photo 1/200..." Foreground="#8B949E" FontSize="11" DockPanel.Dock="Right"/>
                                <TextBlock x:Name="TxtBatchStatus" Text="Téléversement du lot de photos en cours..." Foreground="#F0F6FC" FontWeight="Bold" FontSize="12"/>
                            </DockPanel>
                            <ProgressBar x:Name="ProgressBatch" Height="10" Margin="0,6,0,0" Foreground="#238636" Background="#21262D"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 2. Pied de page -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnClose" Content="Fermer" Style="{StaticResource ObsActionButton}" DockPanel.Dock="Right" Click="BtnClose_Click"/>
                <TextBlock x:Name="TxtGlobalStatus" Text="Le direct est écrit dans Supabase et lu par EECC TV."
                           Foreground="#2FE06A" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
