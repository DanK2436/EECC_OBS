<Window x:Class="EeccStudio.GraphicsBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habillage à l'écran — EECC Studio"
        Height="720" Width="980"
        MinHeight="640" MinWidth="860"
        Background="#14151C"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Habillage" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock DockPanel.Dock="Top" Text="Textes fixes, textes défilants et images de la scène." Foreground="#8E9297" TextWrapping="Wrap" Margin="0,4,12,12"/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,12,12">
                <Button Content="Texte fixe" Click="AddStill_Click" Padding="10,6" Margin="0,0,0,6" Background="#1F4B99" Foreground="White" BorderThickness="0"/>
                <Button Content="Texte défilant" Click="AddScroll_Click" Padding="10,6" Margin="0,0,0,6" Background="#1C2128" Foreground="White" BorderBrush="#30363D"/>
                <Button Content="Image" Click="AddImage_Click" Padding="10,6" Background="#1C2128" Foreground="White" BorderBrush="#30363D"/>
            </StackPanel>
            <ListBox x:Name="ListGraphics" Background="#0D1117" Foreground="White" BorderBrush="#30363D" SelectionChanged="ListGraphics_SelectionChanged"/>
        </DockPanel>
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nom" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" Padding="8,6" Margin="0,0,0,10" Background="#0D1117" Foreground="White" BorderBrush="#30363D"/>
                    <TextBlock x:Name="LblPrimary" Text="Texte" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrimary" Padding="8,6" Margin="0,0,0,10" Background="#0D1117" Foreground="White" BorderBrush="#30363D" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LblSecondary" Text="Deuxième ligne" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSecondary" Padding="8,6" Margin="0,0,0,10" Background="#0D1117" Foreground="White" BorderBrush="#30363D"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Style" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboStyle" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Animation" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboMotion" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Forme" Foreground="#C9D1D9" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboShape" Padding="6,4"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Position et taille, en pourcentage de l'écran" Foreground="#C9D1D9" Margin="0,14,0,6"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="LblX" Text="X  3" Foreground="#8E9297"/>
                            <Slider x:Name="SliderX" Minimum="0" Maximum="90" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="LblY" Text="Y  68" Foreground="#8E9297"/>
                            <Slider x:Name="SliderY" Minimum="0" Maximum="90" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="LblW" Text="Largeur  52" Foreground="#8E9297"/>
                            <Slider x:Name="SliderW" Minimum="8" Maximum="100" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LblH" Text="Hauteur  18" Foreground="#8E9297"/>
                            <Slider x:Name="SliderH" Minimum="6" Maximum="80" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </UniformGrid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="LblSize" Text="Taille du texte  16" Foreground="#8E9297"/>
                            <Slider x:Name="SliderSize" Minimum="12" Maximum="64" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LblSpeed" Text="Vitesse  70" Foreground="#8E9297"/>
                            <Slider x:Name="SliderSpeed" Minimum="20" Maximum="220" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="BtnBrowse" Content="Choisir une image" Click="Browse_Click" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0" Background="#1C2128" Foreground="White" BorderBrush="#30363D" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#0A0C0E" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" ClipToBounds="True">
                <Canvas x:Name="PreviewCanvas" Background="#10141A"/>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Retirer" Click="Remove_Click" Padding="14,7" Margin="0,0,8,0" Background="#2A1616" Foreground="#FF8A8A" BorderBrush="#5C1D1D"/>
                <Button Content="Afficher à l'écran" Click="Apply_Click" Padding="14,7" Background="#1F4B99" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
