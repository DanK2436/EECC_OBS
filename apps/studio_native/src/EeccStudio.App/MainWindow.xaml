<Window x:Class="EeccStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EECC Studio — Régie Broadcast Native (C# / C++)" 
        Height="800" Width="1280"
        MinHeight="720" MinWidth="1024"
        Background="#14151C"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/eecc.ico">
    
    <Window.Resources>
        <ResourceDictionary Source="Theme/StudioColors.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barre de menu / Titre -->
            <RowDefinition Height="*"/>    <!-- Zone Moniteurs (Aperçu & Programme) -->
            <RowDefinition Height="240"/>  <!-- Docks OBS (Scènes, Sources, Mixeur, Contrôles) -->
            <RowDefinition Height="28"/>   <!-- Barre de statut -->
        </Grid.RowDefinitions>

        <!-- 1. BARRE DE TITRE & MENU SUPÉRIEUR (Style OBS Studio Yami) -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#14151C" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="✦" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="EECC STUDIO" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnPairQr" Content="Appairer EECC Caméra (QR)" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="12,5" Margin="0,0,10,0" FontWeight="SemiBold" Click="BtnPairQr_Click"/>
                        <Button x:Name="BtnMutePlayback" Content="Couper le son reçu" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="12,5" Margin="0,0,10,0" Click="BtnMutePlayback_Click"/>
                        <Border Background="#30363D" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="Diffusion externe non branchée" Foreground="#F0F6FC" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <Menu Background="Transparent" Foreground="#F0F6FC" Padding="8,0,8,4">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="#111111"/>
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter Property="Foreground" Value="#F0F6FC"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelItem">
                                    <Setter Property="Foreground" Value="#F0F6FC"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="Fichier">
                        <MenuItem Header="Appairer EECC Caméra" Click="BtnPairQr_Click"/>
                        <Separator/>
                        <MenuItem Header="Quitter" Click="MenuQuit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Édition">
                        <MenuItem Header="Couper ou rétablir le son reçu" Click="BtnMutePlayback_Click"/>
                        <MenuItem Header="Copier, coller et annuler (non branchés)" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Affichage">
                        <MenuItem Header="Le double moniteur est déjà affiché" IsEnabled="False"/>
                        <MenuItem Header="Plein écran et projecteurs (non branchés)" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Collection de scènes">
                        <MenuItem Header="Nouvelle scène caméra" Click="MenuNewCameraScene_Click"/>
                        <MenuItem Header="Nouvelle scène fond" Click="MenuNewColorScene_Click"/>
                        <MenuItem Header="Supprimer la scène d'aperçu" Click="MenuDeleteScene_Click"/>
                    </MenuItem>
                    <MenuItem Header="Profils">
                        <MenuItem Header="Aucun profil n'est enregistré" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Outils">
                        <MenuItem Header="Tally aperçu" Click="BtnTallyPreview_Click"/>
                        <MenuItem Header="Tally programme" Click="BtnTallyProgram_Click"/>
                        <MenuItem Header="Tally attente" Click="BtnTallyStandby_Click"/>
                        <Separator/>
                        <MenuItem Header="Démarrer l'enregistrement" Click="MenuRecordStart_Click"/>
                        <MenuItem Header="Arrêter et finaliser l'enregistrement" Click="MenuRecordStop_Click"/>
                        <MenuItem Header="Démarrer la diffusion RTMP locale" Click="MenuStreamStart_Click"/>
                        <MenuItem Header="Arrêter la diffusion" Click="MenuStreamStop_Click"/>
                    </MenuItem>
                    <MenuItem Header="Aide" Click="MenuHelp_Click"/>
                </Menu>
            </DockPanel>
        </Border>

        <!-- 2. DOUBLE MONITEUR VIDÉO (Mode Studio : Aperçu Vert à gauche / Programme Rouge à droite) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Moniteur Gauche : APERÇU (Preview - Vert #16A34A) -->
            <Border Grid.Column="0" Background="#0D1117" BorderBrush="#16A34A" BorderThickness="2" CornerRadius="8">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                    <TextBlock x:Name="PreviewPlaceholder" Text="Aucune image reçue du téléphone." Foreground="#8B949E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"/>
                    <TextBlock Text="APERÇU REÇU" Foreground="#16A34A" FontWeight="Bold" FontSize="12" Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Boutons de Transition Centraux (Cut & Fade) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="BtnCut" Content="COUPER" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Black" Padding="8,8" Margin="0,4" BorderThickness="0" Click="BtnCut_Click"/>
                <Button x:Name="BtnTransition" Content="TALLY ANTENNE" Background="#7F1D1D" Foreground="#FFFFFF" FontWeight="Black" Padding="8,8" Margin="0,4" BorderThickness="0" Click="BtnTallyProgram_Click"/>
                <Button Content="TALLY APERÇU" Background="#15803D" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,6" Margin="0,4" BorderThickness="0" Click="BtnTallyPreview_Click"/>
                <Button Content="TALLY ATTENTE" Background="#21262D" Foreground="#F0F6FC" FontWeight="Bold" Padding="8,6" Margin="0,4" BorderBrush="#30363D" Click="BtnTallyStandby_Click"/>
                <Button Content="FONDU" Background="#21262D" Foreground="#F0F6FC" FontWeight="Bold" Padding="8,6" Margin="0,4" BorderBrush="#30363D" Click="BtnDissolve_Click"/>
                <TextBlock Text="Couper et fondu changent l'image programme. Le tally reste un signal séparé." Foreground="#8B949E" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Width="100" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Moniteur Droit : PROGRAMME DIRECT (Program - Rouge #DC2626) -->
            <Border Grid.Column="2" Background="#0D1117" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="8">
                <Grid>
                    <Image x:Name="ProgramImage" Stretch="Uniform" Margin="8"/>
                    <TextBlock x:Name="ProgramStatus" Text="Programme distinct de l'aperçu. Couper pour l'y envoyer." Foreground="#F0F6FC" FontSize="13" TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="PROGRAMME" Foreground="#DC2626" FontWeight="Bold" FontSize="12" Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. DOCKS INSPIRÉS D'OBS STUDIO (Scènes, Sources, Mixeur, Commandes) -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- DOCK 1 : SCÈNES -->
                <GroupBox Grid.Column="0" Header="Scènes" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                            <Button Content="+" Padding="8,2" Margin="0,0,4,0" Click="MenuNewCameraScene_Click"/>
                            <Button Content="Fond" Padding="8,2" Margin="0,0,4,0" Click="MenuNewColorScene_Click"/>
                            <Button Content="Suppr." Padding="8,2" Click="MenuDeleteScene_Click"/>
                        </StackPanel>
                        <ListBox x:Name="SceneList" Background="#0D1117" Foreground="#F0F6FC" BorderThickness="0" Margin="4" SelectionChanged="SceneList_SelectionChanged"/>
                    </DockPanel>
                </GroupBox>

                <!-- DOCK 2 : SOURCES -->
                <GroupBox Grid.Column="1" Header="Source de la scène" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <TextBlock x:Name="SourceText" Margin="8" TextWrapping="Wrap" Foreground="#F0F6FC" Text="Caméra EECC reçue, ou fond de couleur généré. HDMI, diapositives et overlay ne sont pas disponibles."/>
                </GroupBox>

                <!-- DOCK 3 : MIXEUR AUDIO PRO (Paliers solides stricts Vert/Jaune/Rouge) -->
                <GroupBox Grid.Column="2" Header="Mixeur — non branché" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <!-- Canal 1 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Master (PGM)" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="0" Minimum="0" Maximum="100" Margin="0,6" IsEnabled="False"/>
                                <Border Height="6" Background="#30363D" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="non mesuré" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Canal 2 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Micro Pasteur" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="0" Minimum="0" Maximum="100" Margin="0,6" IsEnabled="False"/>
                                <Border Height="6" Background="#30363D" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="non mesuré" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Canal 3 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Chœur / Musique" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="0" Minimum="0" Maximum="100" Margin="0,6" IsEnabled="False"/>
                                <Border Height="6" Background="#30363D" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="non mesuré" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Canal 4 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="EECC Caméra 1" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="0" Minimum="0" Maximum="100" Margin="0,6" IsEnabled="False"/>
                                <Border Height="6" Background="#30363D" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="non mesuré" Foreground="#8B949E" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- DOCK 4 : COMMANDES DE DIFFUSION -->
                <GroupBox Grid.Column="3" Header="Commandes" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <StackPanel Margin="4">
                        <Button Content="Enregistrer le programme" Click="MenuRecordStart_Click" Background="#21262D" Foreground="#F0F6FC" Padding="8,6" Margin="0,2" BorderBrush="#30363D"/>
                        <Button Content="Finaliser l'enregistrement" Click="MenuRecordStop_Click" Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D"/>
                        <Button Content="Diffuser vers RTMP" Click="MenuStreamStart_Click" Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D"/>
                        <Button Content="Arrêter la diffusion" Click="MenuStreamStop_Click" Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D"/>
                        <Button Content="Paramètres" Tag="Le mixage, le plein écran et les profils ne sont pas branchés." Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D" Click="BtnUnwired_Click"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Border>

        <!-- 4. BARRE DE STATUT BROADCAST (OBS Yami) -->
        <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusServerText" DockPanel.Dock="Right" Text="Aucun téléphone appairé" Foreground="#8B949E" FontSize="11" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusMeasuredText" Text="Aucune mesure audio/vidéo" Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
