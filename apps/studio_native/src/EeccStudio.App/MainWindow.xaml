<Window x:Class="EeccStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EECC Studio — Régie Broadcast Native (C# / C++)" 
        Height="800" Width="1280"
        MinHeight="720" MinWidth="1024"
        Background="#14151C"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary Source="Theme/StudioColors.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barre de menu / Titre -->
            <RowDefinition Height="*"/>    <!-- Zone Moniteurs (Aperçu & Programme) -->
            <RowDefinition Height="240"/>  <!-- Docks OBS (Scènes, Sources, Mixeur, Contrôles) -->
            <RowDefinition Height="28"/>   <!-- Barre de statut -->
        </Grid.RowDefinitions>

        <!-- 1. BARRE DE TITRE & MENU SUPÉRIEUR (Style OBS Studio Yami) -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Logo Vectoriel Déployé EECC Studio -->
                    <Border Width="28" Height="28" CornerRadius="6" Background="#14151C" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="✦" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="EECC STUDIO" FontWeight="Black" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#30363D" Width="1" Margin="14,2"/>
                    <Menu Background="Transparent" Foreground="#F0F6FC" VerticalAlignment="Center">
                        <MenuItem Header="Fichier" Foreground="#F0F6FC"/>
                        <MenuItem Header="Édition" Foreground="#F0F6FC"/>
                        <MenuItem Header="Affichage" Foreground="#F0F6FC"/>
                        <MenuItem Header="Collection de scènes" Foreground="#F0F6FC"/>
                        <MenuItem Header="Profils" Foreground="#F0F6FC"/>
                        <MenuItem Header="Outils" Foreground="#F0F6FC"/>
                        <MenuItem Header="Aide" Foreground="#F0F6FC"/>
                    </Menu>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnPairQr" Content="Appairer EECC Caméra (QR)" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="12,5" Margin="0,0,10,0" FontWeight="SemiBold" Click="BtnPairQr_Click"/>
                    <Border Background="#DC2626" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="DIFFUSION EN COURS" Foreground="#FFFFFF" FontSize="11" FontWeight="Black"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. DOUBLE MONITEUR VIDÉO (Mode Studio : Aperçu Vert à gauche / Programme Rouge à droite) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Moniteur Gauche : APERÇU (Preview - Vert #16A34A) -->
            <Border Grid.Column="0" Background="#0D1117" BorderBrush="#16A34A" BorderThickness="2" CornerRadius="8">
                <Grid>
                    <TextBlock Text="APERÇU (PREVIEW)" Foreground="#16A34A" FontWeight="Bold" FontSize="12" Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="[ Flux Caméra Mobile 1 - Pupitre ]" Foreground="#8B949E" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="1920x1080 @ 60 FPS — 5200 kbps" Foreground="#16A34A" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Boutons de Transition Centraux (Cut & Fade) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="BtnTransition" Content="COUPER ▶" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Black" Padding="12,8" Margin="0,4" BorderThickness="0" Click="BtnTransition_Click"/>
                <Button Content="FONDU" Background="#21262D" Foreground="#F0F6FC" FontWeight="Bold" Padding="12,6" Margin="0,4" BorderBrush="#30363D"/>
                <TextBlock Text="300 ms" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Moniteur Droit : PROGRAMME DIRECT (Program - Rouge #DC2626) -->
            <Border Grid.Column="2" Background="#0D1117" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="8">
                <Grid>
                    <TextBlock Text="PROGRAMME (À L'ANTENNE)" Foreground="#DC2626" FontWeight="Bold" FontSize="12" Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="[ Vue Globale Culte Dominical ]" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Diffusé vers YouTube, Facebook &amp; EECC TV" Foreground="#DC2626" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. DOCKS INSPIRÉS D'OBS STUDIO (Scènes, Sources, Mixeur, Commandes) -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- DOCK 1 : SCÈNES -->
                <GroupBox Grid.Column="0" Header="Scènes" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <ListBox Background="#0D1117" Foreground="#F0F6FC" BorderThickness="0" Margin="4">
                        <ListBoxItem IsSelected="True" Content="• Culte — Prédication (Direct)"/>
                        <ListBoxItem Content="• Culte — Louange &amp; Chœur"/>
                        <ListBoxItem Content="• Orateur + Diapositive (Split)"/>
                        <ListBoxItem Content="• Plein Écran Présentation"/>
                        <ListBoxItem Content="• Attente Avant Culte"/>
                    </ListBox>
                </GroupBox>

                <!-- DOCK 2 : SOURCES -->
                <GroupBox Grid.Column="1" Header="Sources de la scène" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <ListBox Background="#0D1117" Foreground="#F0F6FC" BorderThickness="0" Margin="4">
                        <ListBoxItem Content="[Caméra] EECC Caméra 1 (Mobile sans fil)"/>
                        <ListBoxItem Content="[Caméra] Caméra Fixe Autel (HDMI Capture)"/>
                        <ListBoxItem Content="[Capture] Diapositives PowerPoint / Écran"/>
                        <ListBoxItem Content="[Audio] Micro HF Pasteur"/>
                        <ListBoxItem Content="[Overlay] Bandeau Titre Prédicateur"/>
                    </ListBox>
                </GroupBox>

                <!-- DOCK 3 : MIXEUR AUDIO PRO (Paliers solides stricts Vert/Jaune/Rouge) -->
                <GroupBox Grid.Column="2" Header="Mixeur Audio (WASAPI 32-bit)" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <!-- Canal 1 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Master (PGM)" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="85" Minimum="0" Maximum="100" Margin="0,6"/>
                                <Border Height="6" Background="#16A34A" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="-14.2 dB" Foreground="#16A34A" FontSize="10" HorizontalAlignment="Center" FontFamily="JetBrains Mono"/>
                            </StackPanel>
                            <!-- Canal 2 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Micro Pasteur" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="90" Minimum="0" Maximum="100" Margin="0,6"/>
                                <Border Height="6" Background="#F59E0B" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="-8.5 dB" Foreground="#F59E0B" FontSize="10" HorizontalAlignment="Center" FontFamily="JetBrains Mono"/>
                            </StackPanel>
                            <!-- Canal 3 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="Chœur / Musique" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="75" Minimum="0" Maximum="100" Margin="0,6"/>
                                <Border Height="6" Background="#16A34A" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="-18.0 dB" Foreground="#16A34A" FontSize="10" HorizontalAlignment="Center" FontFamily="JetBrains Mono"/>
                            </StackPanel>
                            <!-- Canal 4 -->
                            <StackPanel Width="110" Margin="6,0">
                                <TextBlock Text="EECC Caméra 1" Foreground="#F0F6FC" FontSize="11" HorizontalAlignment="Center"/>
                                <Slider Orientation="Vertical" Height="110" Value="60" Minimum="0" Maximum="100" Margin="0,6"/>
                                <Border Height="6" Background="#16A34A" CornerRadius="2" Margin="10,2"/>
                                <TextBlock Text="-22.1 dB" Foreground="#16A34A" FontSize="10" HorizontalAlignment="Center" FontFamily="JetBrains Mono"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- DOCK 4 : COMMANDES DE DIFFUSION -->
                <GroupBox Grid.Column="3" Header="Commandes" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="4">
                    <StackPanel Margin="4">
                        <Button Content="Arrêter le streaming" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,6" Margin="0,2" BorderThickness="0"/>
                        <Button Content="Démarrer l'enregistrement" Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D"/>
                        <Button Content="Mode Studio" Background="#16A34A" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="8,5" Margin="0,2" BorderThickness="0"/>
                        <Button Content="Paramètres" Background="#21262D" Foreground="#F0F6FC" Padding="8,5" Margin="0,2" BorderBrush="#30363D"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Border>

        <!-- 4. BARRE DE STATUT BROADCAST (OBS Yami) -->
        <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="LIVE: 01:28:44" Foreground="#DC2626" FontWeight="Bold" FontFamily="JetBrains Mono" Margin="0,0,16,0"/>
                    <TextBlock Text="REC: 01:28:44" Foreground="#F0F6FC" FontFamily="JetBrains Mono" Margin="0,0,16,0"/>
                    <TextBlock Text="CPU: 4.8%" Foreground="#8B949E" FontFamily="JetBrains Mono" Margin="0,0,16,0"/>
                    <TextBlock Text="60.00 FPS" Foreground="#16A34A" FontWeight="Bold" FontFamily="JetBrains Mono" Margin="0,0,16,0"/>
                    <TextBlock Text="5850 kbps" Foreground="#16A34A" FontFamily="JetBrains Mono"/>
                </StackPanel>
                <TextBlock Text="Serveur Caméra Mobile Actif (Port 8089) — 1 Caméra Connectée" Foreground="#8B949E" HorizontalAlignment="Right" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
