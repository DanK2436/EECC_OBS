<Window x:Class="EeccStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OBS Studio 30.2 - Profil: Culte EECC - Scènes: Production Culte" 
        Height="900" Width="1480"
        MinHeight="720" MinWidth="1100"
        Background="{StaticResource ObsWindowBackground}"
        FontFamily="Segoe UI"
        Icon="Assets/eecc.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/StudioColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Style Menu Principal OBS -->
            <Style x:Key="ObsMenuStyle" TargetType="Menu">
                <Setter Property="Background" Value="{StaticResource ObsHeaderBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ObsTextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="25"/>
            </Style>

            <Style x:Key="ObsMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource ObsTextPrimary}"/>
                <Setter Property="Padding" Value="8,3"/>
            </Style>

            <!-- Style Titre de Dock OBS avec poignée de glissement -->
            <Style x:Key="ObsDockTitleBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ObsHeaderBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ObsDockBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Height" Value="26"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- GRILLE PRINCIPALE OBS STUDIO : 3 RANGÉES (MENU, ESPACE VIDÉO, DOCKS ET STATUS) -->
    <Grid Background="{StaticResource ObsWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Barre de Menus Supérieure -->
            <RowDefinition Height="*"/>    <!-- 1. Espace Moniteurs Vidéo (Preview / Transition / Program) -->
            <RowDefinition Height="280"/>  <!-- 2. Rangée Inférieure des Docks OBS -->
            <RowDefinition Height="24"/>   <!-- 3. Barre d'État Inférieure Officielle OBS -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. BARRE DE MENUS SUPÉRIEURE (OFFICIELLE OBS STUDIO)      -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{StaticResource ObsHeaderBackground}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Indicateurs d'état droite (Démo / Badge Live) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border x:Name="BadgeDemo" Background="#D97706" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" Visibility="Collapsed">
                        <TextBlock Text="MODE DÉMO" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border x:Name="BadgeLiveIndicator" Background="#23272A" CornerRadius="3" Padding="8,3">
                        <TextBlock x:Name="TxtLiveBadge" Text="HORS LIGNE" FontSize="11" FontWeight="Bold" Foreground="#72767D"/>
                    </Border>
                    <Border x:Name="BadgeRecIndicator" Background="#23272A" CornerRadius="3" Padding="8,3" Margin="6,0,0,0">
                        <TextBlock x:Name="TxtRecBadge" Text="REC: ARRÊT" FontSize="11" FontWeight="Bold" Foreground="#72767D"/>
                    </Border>
                </StackPanel>

                <!-- Menus standards OBS -->
                <Menu Style="{StaticResource ObsMenuStyle}">
                    <!-- 1. MENU FICHIER (OBS STUDIO) -->
                    <MenuItem Header="_Fichier" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Afficher les enregistrements" Click="MenuShowRecordings_Click"/>
                        <MenuItem Header="Convertir un enregistrement (Remux)..." Click="MenuRemux_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Afficher le dossier des paramètres" Click="MenuShowSettingsFolder_Click"/>
                        <MenuItem Header="Afficher le dossier des profils" Click="MenuShowSettingsFolder_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Paramètres..." Click="BtnSettings_Click" InputGestureText="Ctrl+Maj+S"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Quitter" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
                    </MenuItem>

                    <!-- 2. MENU ÉDITION (OBS STUDIO + TRANSFORMATION) -->
                    <MenuItem Header="_Édition" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Annuler" Click="MenuUndo_Click" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Rétablir" Click="MenuRedo_Click" InputGestureText="Ctrl+Y"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Copier la source" Click="MenuCopySource_Click" InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Coller la source (Référence)" Click="MenuPasteSource_Click" InputGestureText="Ctrl+V"/>
                        <MenuItem Header="Dupliquer la scène active" Click="BtnDuplicateScene_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <!-- Sous-Menu Transformer OBS -->
                        <MenuItem Header="Transformer">
                            <MenuItem Header="Modifier la transformation..." Click="MenuSourceProperties_Click" InputGestureText="Ctrl+E"/>
                            <MenuItem Header="Réinitialiser la transformation" Click="MenuEditTransform_Reset_Click" InputGestureText="Ctrl+R"/>
                            <Separator Background="{StaticResource ObsDockBorder}"/>
                            <MenuItem Header="Pivoter de 90° dans le sens horaire" Click="MenuEditTransform_Rotate90CW_Click"/>
                            <MenuItem Header="Pivoter de 90° dans le sens anti-horaire" Click="MenuEditTransform_Rotate90CCW_Click"/>
                            <MenuItem Header="Pivoter de 180° (Corriger tête en bas)" Click="MenuEditTransform_Rotate180_Click"/>
                            <Separator Background="{StaticResource ObsDockBorder}"/>
                            <MenuItem Header="Retourner horizontalement (Miroir)" Click="MenuEditTransform_FlipH_Click"/>
                            <MenuItem Header="Retourner verticalement" Click="MenuEditTransform_FlipV_Click"/>
                            <Separator Background="{StaticResource ObsDockBorder}"/>
                            <MenuItem Header="Ajuster à l'écran" Click="MenuEditTransform_Fit_Click" InputGestureText="Ctrl+F"/>
                            <MenuItem Header="Centrer à l'écran" Click="MenuEditTransform_Center_Click" InputGestureText="Ctrl+D"/>
                        </MenuItem>
                        <!-- Sous-Menu Ordre OBS -->
                        <MenuItem Header="Ordre">
                            <MenuItem Header="Monter" Click="BtnMoveSourceUp_Click" InputGestureText="Ctrl+Haut"/>
                            <MenuItem Header="Descendre" Click="BtnMoveSourceDown_Click" InputGestureText="Ctrl+Bas"/>
                            <MenuItem Header="Tout en haut" Click="BtnMoveSourceTop_Click"/>
                            <MenuItem Header="Tout en bas" Click="BtnMoveSourceBottom_Click"/>
                        </MenuItem>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Propriétés de la source..." Click="MenuSourceProperties_Click"/>
                        <MenuItem Header="Filtres audio et vidéo..." Click="MenuFilters_Click"/>
                        <MenuItem Header="Propriétés audio avancées..." Click="MenuAdvancedAudio_Click"/>
                    </MenuItem>

                    <!-- 3. MENU AFFICHAGE (OBS STUDIO) -->
                    <MenuItem Header="_Affichage" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem x:Name="MenuStudioModeToggle" Header="Mode Studio" IsCheckable="True" IsChecked="True" Click="BtnStudioMode_Click" InputGestureText="F10"/>
                        <MenuItem Header="Plein écran (Interface complète)" Click="MenuFullscreen_Click" InputGestureText="F11"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Réinitialiser l'interface utilisateur" Click="MenuResetUi_Click"/>
                        <MenuItem Header="Verrouiller l'interface utilisateur" IsCheckable="True"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Afficher la barre d'état" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="Afficher les statistiques" Click="MenuLanStatus_Click"/>
                    </MenuItem>

                    <!-- 4. MENU DOCKS (OBS STUDIO + EECC SPÉCIFICATIONS) -->
                    <MenuItem Header="_Docks" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Verrouiller les Docks" IsCheckable="True"/>
                        <MenuItem Header="Réinitialiser les Docks" Click="MenuResetUi_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Scènes" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="Sources" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="Mélangeur audio" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="Transitions de scène" IsCheckable="True" IsChecked="True"/>
                        <MenuItem Header="Commandes" IsCheckable="True" IsChecked="True"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <!-- Docks spécifiques Écosystème EECC -->
                        <MenuItem Header="📱 Dock Surveillance EECC Caméra (15 Mobiles Wi-Fi)" IsCheckable="True" IsChecked="True" Click="BtnPairQr_Click"/>
                        <MenuItem Header="📺 Dock Diffusion EECC TV (Flux &amp; Métadonnées Culte)" IsCheckable="True" IsChecked="True" Click="MenuTools_EeccTvMeta_Click"/>
                    </MenuItem>

                    <!-- 5. MENU PROFIL (OBS STUDIO) -->
                    <MenuItem Header="_Profil" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Nouveau profil..." Click="MenuProfileNew_Click"/>
                        <MenuItem Header="Dupliquer" Click="MenuProfileDuplicate_Click"/>
                        <MenuItem Header="Renommer" Click="MenuProfileRename_Click"/>
                        <MenuItem Header="Exporter..." Click="MenuProfileExport_Click"/>
                        <MenuItem Header="Importer..." Click="MenuProfileImport_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem x:Name="MenuProfileSunday" Header="Culte Dominical EECC (Par défaut)" IsCheckable="True" IsChecked="True" Click="MenuProfilePick_Click"/>
                        <MenuItem x:Name="MenuProfileChoir" Header="Répétition Chorale &amp; Louange" IsCheckable="True" Click="MenuProfilePick_Click"/>
                        <MenuItem x:Name="MenuProfileSeminar" Header="Séminaire &amp; Événement Spécial" IsCheckable="True" Click="MenuProfilePick_Click"/>
                    </MenuItem>

                    <!-- 6. MENU COLLECTION DE SCÈNES (OBS STUDIO) -->
                    <MenuItem Header="_Collection de scènes" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Nouvelle collection..." Click="MenuCollectionNew_Click"/>
                        <MenuItem Header="Dupliquer" Click="MenuCollectionDuplicate_Click"/>
                        <MenuItem Header="Renommer" Click="MenuCollectionRename_Click"/>
                        <MenuItem Header="Exporter..." Click="MenuProfileExport_Click"/>
                        <MenuItem Header="Importer..." Click="MenuProfileImport_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem x:Name="MenuCollectionProduction" Header="Production Culte EECC (Scène Actuelle)" IsCheckable="True" IsChecked="True" Click="MenuCollectionPick_Click"/>
                        <MenuItem x:Name="MenuCollectionDemo" Header="Studio Démo &amp; Tests" IsCheckable="True" Click="MenuCollectionPick_Click"/>
                    </MenuItem>

                    <!-- 7. MENU OUTILS (OBS STUDIO + SPÉCIFICATIONS EECC CAMÉRA & EECC TV) -->
                    <MenuItem Header="_Outils" Style="{StaticResource ObsMenuItemStyle}">
                        <!-- Outils OBS Classiques -->
                        <MenuItem Header="Assistant de configuration automatique..." Click="MenuTools_AutoConfig_Click"/>
                        <MenuItem Header="🖥️ Canevas Vidéo &amp; Budget GPU (1080p, 4K, 8K, 16K)..." Click="MenuCanvasGpu_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="🎥 Périphériques Physiques &amp; Cartes HDMI/USB..." Click="MenuPhysicalDevices_Click"/>
                        <MenuItem Header="🎞️ Sauvegarder Instant Replay (Ralenti 30s)..." Click="MenuReplayBuffer_Click"/>
                        <MenuItem Header="📷 Caméra Virtuelle (Zoom, Teams, Meet)..." Click="MenuVirtualCamera_Click"/>
                        <MenuItem Header="🎛️ Contrôle Stream Deck &amp; Companion (WebSocket v5:4455)..." Click="MenuObsWebSocket_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="Habillage à l'écran (textes et images)..." Click="MenuGraphics_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>

                        <!-- SPÉCIFICATIONS OFFICIELLES EECC CAMÉRA -->
                        <MenuItem Header="📱 EECC Caméra : Appairer un smartphone (QR Code Wi-Fi 3 min)..." Click="BtnPairQr_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="📶 EECC Caméra : Diagnostic Réseau LAN (Routeur partagé, Ping, Jitter)..." Click="MenuLanStatus_Click"/>
                        <MenuItem Header="🔦 EECC Caméra : Contrôle à distance Torche &amp; Tally..." Click="MenuTools_EeccCamTorch_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>

                        <!-- SPÉCIFICATIONS OFFICIELLES EECC TV -->
                        <MenuItem Header="📺 EECC TV : Gestionnaire de Contenus (Podcasts, Audios, Vidéos, Textes, Affiches, 200 Photos)..." Click="MenuCmsManager_Click" FontWeight="Bold" InputGestureText="Ctrl+Maj+M"/>
                        <MenuItem Header="📺 EECC TV : Métadonnées du Culte (Titre, Orateur, Thème, Versets)..." Click="MenuTools_EeccTvMeta_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="📡 EECC TV : Configuration Ingest Direct HTTP / MJPEG (Port 8089)..." Click="MenuTools_EeccTvIngest_Click"/>
                        <MenuItem Header="☁️ EECC TV : Synchronisation Catalogue &amp; Replays (Supabase Cloud)..." Click="MenuTools_EeccTvSync_Click"/>
                        <MenuItem Header="🎙️ EECC TV &amp; Médiathèque : Exportation Podcast Prédication vers Google Drive..." Click="MenuPostProd_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>

                        <!-- Module Trésorerie & Dons -->
                        <MenuItem Header="💳 Trésorerie : Validation Retraits Sécurisés OTP (Brevo / MaishaPay)..." Click="MenuTreasury_Click"/>
                    </MenuItem>

                    <!-- 8. MENU AIDE (OBS STUDIO) -->
                    <MenuItem Header="_Aide" Style="{StaticResource ObsMenuItemStyle}">
                        <MenuItem Header="Portail d'aide &amp; Guide EECC Ecosystem"/>
                        <MenuItem Header="Site officiel EECC"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <!-- Sous-Menu Fichiers Journaux OBS -->
                        <MenuItem Header="Fichiers journaux (Logs)">
                            <MenuItem Header="Afficher les fichiers journaux" Click="MenuHelp_Logs_Click"/>
                            <MenuItem Header="Afficher le journal de la session actuelle" Click="MenuHelp_Logs_Click"/>
                            <MenuItem Header="Transmettre le journal de streaming..."/>
                        </MenuItem>
                        <MenuItem Header="Rapports de plantage (Crash Logs)"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="Rechercher des mises à jour..."/>
                        <MenuItem Header="Contrat de licence &amp; Crédits Open-Source (OBS, Jellyfin)" Click="MenuLicense_Click"/>
                        <Separator Background="{StaticResource ObsDockBorder}"/>
                        <MenuItem Header="À propos d'EECC Studio (v30.2 - Église Évangélique du Centre)..." Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. ZONE CENTRALE : MODE STUDIO OBS (PREVIEW / TRANS / PGM) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Background="{StaticResource ObsWindowBackground}" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColPreview" Width="*"/>   <!-- Moniteur Gauche : Aperçu (Preview) -->
                <ColumnDefinition x:Name="ColTransitions" Width="130"/> <!-- Colonne Centrale : Transition & T-Bar -->
                <ColumnDefinition Width="*"/>   <!-- Moniteur Droite : Programme (Program ON-AIR) -->
            </Grid.ColumnDefinitions>

            <!-- 1.1 MONITEUR APERÇU (PREVIEW) -->
            <Border Grid.Column="0" x:Name="BorderPreview" Background="{StaticResource ObsDockBackground}" BorderBrush="#15803D" BorderThickness="1.5" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/> <!-- En-Tête Aperçu -->
                        <RowDefinition Height="*"/>  <!-- Zone Rendu Vidéo 16:9 -->
                        <RowDefinition Height="22"/> <!-- Pied de Scène Aperçu -->
                    </Grid.RowDefinitions>

                    <!-- En-tête Aperçu -->
                    <Border Grid.Row="0" Background="#16221A" BorderBrush="#15803D" BorderThickness="0,0,0,1" Padding="8,2">
                        <DockPanel>
                            <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#2FE06A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreviewSceneName" Text="Scène : Culte" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Écran Vidéo Aperçu avec Overlays (Logo, Texte, Bande Déroulante OBS) -->
                    <Grid Grid.Row="1" Background="#0A0C0E">
                        <Image x:Name="ImgPreviewVideo" Stretch="Uniform"/>
                        <!-- Ardoise si aucune image -->
                        <Grid x:Name="PanelPreviewSlate" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PREVIEW" FontSize="20" FontWeight="Bold" Foreground="#2FE06A" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock x:Name="TxtPreviewMain" Text="Aperçu Studio" FontSize="13" Foreground="{StaticResource ObsTextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtPreviewSub" Text="Aucun signal vidéo" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPreviewEmpty" Text="" FontSize="10" Foreground="#E03232" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Canvas x:Name="CanvasPreviewGraphics" IsHitTestVisible="False"/>
                        <Image x:Name="ImgPreviewLogo" Visibility="Collapsed"/>
                        <Border x:Name="PanelPreviewLowerThird" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtPreviewLowerTitle"/>
                                <TextBlock x:Name="TxtPreviewLowerSub"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PanelPreviewTicker" Visibility="Collapsed">
                            <Canvas x:Name="CanvasPreviewTicker">
                                <TextBlock x:Name="TxtPreviewTicker"/>
                            </Canvas>
                        </Border>
                    </Grid>

                    <!-- Pied de scène Aperçu -->
                    <Border Grid.Row="2" Background="{StaticResource ObsHeaderBackground}" Padding="8,2">
                        <TextBlock x:Name="TxtPreviewOverlay" Text="[ Caméra Principale ]" FontSize="10" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1.2 COLONNE CENTRALE OBS : COMMANDES DE TRANSITION & T-BAR -->
            <Border Grid.Column="1" x:Name="PanelTransitions" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="4,2">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Bouton Transition Principal -->
                        <RowDefinition Height="Auto"/> <!-- Bouton Coupure (Cut) -->
                        <RowDefinition Height="Auto"/> <!-- Bouton Fondu (Fade) -->
                        <RowDefinition Height="*"/>    <!-- Réglette en T (T-Bar) -->
                        <RowDefinition Height="Auto"/> <!-- Entrée Durée ms -->
                        <RowDefinition Height="Auto"/> <!-- Bouton Fondu au noir (FTB) -->
                    </Grid.RowDefinitions>

                    <!-- Grand Bouton Transition Central OBS -->
                    <Button Grid.Row="0" x:Name="BtnCut" Click="BtnCut_Click" Height="42" Margin="0,2,0,6"
                            Background="{StaticResource ObsButtonNormal}" Foreground="{StaticResource ObsTextWhite}"
                            BorderBrush="{StaticResource ObsButtonBorder}" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                    <TextBlock Text="Transition" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ObsButtonHover}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource ObsAccentBlue}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Coupure rapide (Cut) -->
                    <Button Grid.Row="1" Click="BtnCut_Click" Style="{StaticResource ObsCommandButtonStyle}" Height="28" Margin="0,2">
                        <TextBlock Text="Coupure" FontSize="11"/>
                    </Button>

                    <!-- Fondu rapide (Fade) -->
                    <Button Grid.Row="2" x:Name="BtnFade" Click="BtnFade_Click" Style="{StaticResource ObsCommandButtonStyle}" Height="28" Margin="0,2">
                        <TextBlock x:Name="TxtFadeButton" Text="Fondu (300 ms)" FontSize="11"/>
                    </Button>

                    <!-- Réglette en T (T-Bar Transition Slider OBS) -->
                    <Grid Grid.Row="3" Margin="0,8">
                        <Slider x:Name="TBarSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="0"
                                HorizontalAlignment="Center" Cursor="Hand" SmallChange="5" LargeChange="20"
                                ValueChanged="TBarSlider_ValueChanged" PreviewMouseLeftButtonUp="TBarSlider_Released"/>
                    </Grid>

                    <!-- Durée de transition en ms -->
                    <StackPanel Grid.Row="4" Margin="0,4">
                        <TextBlock Text="Durée :" FontSize="10" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="TxtCenterTransitionDuration" Text="300 ms" FontSize="11" Foreground="{StaticResource ObsTextWhite}" Background="{StaticResource ObsDockBackground}"
                                 BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" HorizontalContentAlignment="Center" Margin="0,2,0,0" Padding="2"
                                 LostFocus="TransitionDuration_LostFocus"/>
                    </StackPanel>

                    <!-- Fondu au Noir (FTB) -->
                    <Button Grid.Row="5" x:Name="BtnFadeToBlack" Click="BtnFadeToBlack_Click" Height="26" Margin="0,6,0,2"
                            Background="#2A1616" Foreground="#FF6B6B" BorderBrush="#5C1D1D" BorderThickness="1" Cursor="Hand" FontSize="10" FontWeight="SemiBold">
                        <TextBlock Text="Fondu au Noir"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 1.3 MONITEUR PROGRAMME (PROGRAM ON-AIR) -->
            <Border Grid.Column="2" Background="{StaticResource ObsDockBackground}" BorderBrush="#E03232" BorderThickness="1.5" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/> <!-- En-Tête Programme -->
                        <RowDefinition Height="*"/>  <!-- Zone Rendu Vidéo 16:9 -->
                        <RowDefinition Height="22"/> <!-- Pied de Scène Programme -->
                    </Grid.RowDefinitions>

                    <!-- En-tête Programme avec feu On-Air -->
                    <Border Grid.Row="0" Background="#281414" BorderBrush="#E03232" BorderThickness="0,0,0,1" Padding="8,2">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="PgmOnAirPill" Background="#E03232" CornerRadius="2" Padding="5,1" Margin="0,0,6,0" Visibility="Visible">
                                    <TextBlock Text="ON-AIR" FontSize="9" FontWeight="Black" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="PROGRAMME" FontSize="10" FontWeight="Bold" Foreground="#E03232" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtProgramSceneName" Text="[ Culte ]" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Écran Vidéo Programme avec Overlays (Logo, Texte, Bande Déroulante OBS) -->
                    <Grid Grid.Row="1" Background="#0A0C0E">
                        <Image x:Name="ImgProgramMix" Stretch="Uniform" Opacity="0"/>
                        <Image x:Name="ImgProgramVideo" Stretch="Uniform"/>
                        <!-- Ardoise si aucune image -->
                        <Grid x:Name="PanelProgramSlate" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PROGRAMME" FontSize="20" FontWeight="Bold" Foreground="#E03232" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock x:Name="TxtProgramMain" Text="Antenne Master" FontSize="13" Foreground="{StaticResource ObsTextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtProgramSub" Text="Signal diffusé aux fidèles" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtProgramEmpty" Text="" FontSize="10" Foreground="#E03232" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Canvas x:Name="CanvasProgramGraphics" IsHitTestVisible="False"/>
                        <Image x:Name="ImgProgramLogo" Visibility="Collapsed"/>
                        <Border x:Name="PanelProgramLowerThird" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtProgramLowerTitle"/>
                                <TextBlock x:Name="TxtProgramLowerSub"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PanelProgramTicker" Visibility="Collapsed">
                            <Canvas x:Name="CanvasProgramTicker">
                                <TextBlock x:Name="TxtProgramTicker"/>
                            </Canvas>
                        </Border>
                    </Grid>

                    <!-- Pied de scène Programme -->
                    <Border Grid.Row="2" Background="{StaticResource ObsHeaderBackground}" Padding="8,2">
                        <DockPanel>
                            <TextBlock x:Name="TxtProgramLiveFooter" Text="En attente" FontSize="10" Foreground="{StaticResource ObsTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtProgramDetails" Text="00:00:00" FontSize="10" Foreground="#2FE06A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. RANGÉE INFÉRIEURE : LES 5 DOCKS OFFICIELS OBS STUDIO    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Background="{StaticResource ObsWindowBackground}" Margin="6,0,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/> <!-- Dock 1 : Scènes -->
                <ColumnDefinition Width="230"/> <!-- Dock 2 : Sources -->
                <ColumnDefinition Width="*"/>   <!-- Dock 3 : Mélangeur Audio -->
                <ColumnDefinition Width="150"/> <!-- Dock 4 : Transitions de scène -->
                <ColumnDefinition Width="175"/> <!-- Dock 5 : Commandes OBS -->
            </Grid.ColumnDefinitions>

            <!-- DOCK 1 : SCÈNES -->
            <Border Grid.Column="0" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/> <!-- En-Tête Dock -->
                        <RowDefinition Height="*"/>  <!-- Liste des Scènes -->
                        <RowDefinition Height="28"/> <!-- Barre d'outils (+, -, flèches) -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ObsDockTitleBarStyle}">
                        <TextBlock Text="Scènes" Style="{StaticResource ObsDockHeaderStyle}"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="ListScenes" SelectionChanged="ListScenes_SelectionChanged"
                             Background="{StaticResource ObsDockBackground}" BorderThickness="0" Foreground="{StaticResource ObsTextPrimary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="6,3" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource ObsHeaderBackground}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,2">
                            <Button x:Name="BtnAddScene" Click="BtnAddScene_Click" Content="+" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Ajouter une scène"/>
                            <Button x:Name="BtnRemoveScene" Click="BtnRemoveScene_Click" Content="-" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Supprimer la scène"/>
                            <Button x:Name="BtnMoveSceneUp" Click="BtnMoveSceneUp_Click" Content="▲" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Monter"/>
                            <Button x:Name="BtnMoveSceneDown" Click="BtnMoveSceneDown_Click" Content="▼" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Descendre"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DOCK 2 : SOURCES -->
            <Border Grid.Column="1" x:Name="PanelSources" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/> <!-- En-Tête Dock -->
                        <RowDefinition Height="*"/>  <!-- Liste des Sources -->
                        <RowDefinition Height="28"/> <!-- Barre d'outils Sources -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ObsDockTitleBarStyle}">
                        <TextBlock Text="Sources" Style="{StaticResource ObsDockHeaderStyle}"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="ListSources" SelectionChanged="ListSources_SelectionChanged" MouseDoubleClick="ListSources_MouseDoubleClick"
                             Background="{StaticResource ObsDockBackground}" BorderThickness="0" Foreground="{StaticResource ObsTextPrimary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,2">
                                    <Button Content="{Binding EyeGlyph}" Click="SourceEye_Click" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource ObsTextSecondary}" Margin="0,0,6,0" Padding="0" Cursor="Hand" ToolTip="Afficher ou masquer"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource ObsTextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource ObsHeaderBackground}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,2">
                            <Button x:Name="BtnAddSource" Click="BtnAddSource_Click" Content="+" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Ajouter une source"/>
                            <Button x:Name="BtnRemoveSource" Click="BtnRemoveSource_Click" Content="-" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Supprimer la source"/>
                            <Button Content="⚙" Click="MenuSourceProperties_Click" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Propriétés"/>
                            <Button Click="BtnMoveSourceUp_Click" Content="▲" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Monter"/>
                            <Button Click="BtnMoveSourceDown_Click" Content="▼" Style="{StaticResource ObsDockToolButtonStyle}" ToolTip="Descendre"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DOCK 3 : MÉLANGEUR AUDIO -->
            <Border Grid.Column="2" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/> <!-- En-Tête Dock -->
                        <RowDefinition Height="*"/>  <!-- Tranches Audio OBS -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ObsDockTitleBarStyle}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="⚙" Width="22" Height="18" Margin="0,0,6,0"
                                    Click="MenuAdvancedAudio_Click" ToolTip="Propriétés audio avancées"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource ObsTextPrimary}" Cursor="Hand"/>
                            <TextBlock Text="Mélangeur audio" Style="{StaticResource ObsDockHeaderStyle}"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MixerStrips" Margin="4,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="108" Margin="3,0" Padding="4,3"
                                            Background="{StaticResource ObsDockBackground}"
                                            BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Verrouiller / déverrouiller le volume" Click="MixerLock_Click"/>
                                                <MenuItem Header="Propriétés audio avancées..." Click="MenuAdvancedAudio_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="22"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ObsTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="{Binding DbText}" FontSize="9"
                                                       Foreground="{StaticResource ObsTextSecondary}"/>
                                            <Grid Grid.Row="2" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="10"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Orientation="Vertical" Minimum="0" Maximum="100"
                                                        Value="{Binding Fader, Mode=TwoWay}"
                                                        IsEnabled="{Binding CanMove}"
                                                        HorizontalAlignment="Center" TickFrequency="10" TickPlacement="BottomRight"/>
                                                <Border Grid.Column="1" Width="6" Height="120" Background="#111214" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Border Height="{Binding MeterLeft}" VerticalAlignment="Bottom" Background="{Binding MeterBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2" Width="6" Height="120" Background="#111214" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Border Height="{Binding MeterRight}" VerticalAlignment="Bottom" Background="{Binding MeterBrush}"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{Binding MuteGlyph}" Foreground="{Binding MuteBrush}" Click="MixerMute_Click" Tag="{Binding}"
                                                        Width="24" Height="18" Margin="1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Sourdine"/>
                                                <Button Content="{Binding MonitorGlyph}" Click="MixerMonitor_Click" Tag="{Binding}"
                                                        Width="24" Height="18" Margin="1,0" Background="Transparent" BorderBrush="{StaticResource ObsDockBorder}"
                                                        Foreground="{StaticResource ObsTextPrimary}" Cursor="Hand" ToolTip="{Binding MonitorTip}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DOCK 4 : TRANSITIONS DE SCÈNE -->
            <Border Grid.Column="3" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/> <!-- En-Tête Dock -->
                        <RowDefinition Height="*"/>  <!-- Sélecteurs de Transition -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ObsDockTitleBarStyle}">
                        <TextBlock Text="Transitions de scène" Style="{StaticResource ObsDockHeaderStyle}"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8">
                        <TextBlock Text="Transition :" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" Margin="0,2"/>
                        <ComboBox x:Name="ComboSceneTransitions" SelectedIndex="0" Background="{StaticResource ObsDockBackground}" Foreground="{StaticResource ObsTextWhite}" Height="24">
                            <ComboBoxItem Content="Fondu (Fade)"/>
                            <ComboBoxItem Content="Coupure (Cut)"/>
                            <ComboBoxItem Content="Glissement Gauche (Slide Left)"/>
                            <ComboBoxItem Content="Glissement Droite (Slide Right)"/>
                            <ComboBoxItem Content="Fondu au Noir (Fade to Black)"/>
                        </ComboBox>

                        <TextBlock Text="Durée :" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" Margin="0,8,0,2"/>
                        <TextBox x:Name="TxtTransitionDuration" Text="300 ms" Background="{StaticResource ObsDockBackground}" Foreground="{StaticResource ObsTextWhite}"
                                 BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" Padding="4,2" FontSize="11"
                                 LostFocus="TransitionDuration_LostFocus"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DOCK 5 : COMMANDES OBS STUDIO (COLONNE OFFICIELLE) -->
            <Border Grid.Column="4" Background="{StaticResource ObsDockSurface}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="1" CornerRadius="3" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/> <!-- En-Tête Dock -->
                        <RowDefinition Height="*"/>  <!-- Boutons de Commande Empilés -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ObsDockTitleBarStyle}">
                        <TextBlock Text="Commandes" Style="{StaticResource ObsDockHeaderStyle}"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="4,3">
                        <Button x:Name="BtnToggleStream" Click="BtnToggleStream_Click" Content="Démarrer le streaming" Style="{StaticResource ObsCommandButtonStyle}"/>
                        <Button x:Name="BtnToggleRecord" Click="BtnToggleRecord_Click" Content="Démarrer l'enregistrement" Style="{StaticResource ObsCommandButtonStyle}"/>
                        <Button x:Name="BtnPairQr" Click="BtnPairQr_Click" Content="Connecter un téléphone..." Style="{StaticResource ObsCommandButtonStyle}"/>
                        <Button x:Name="BtnToggleStudioMode" Click="BtnStudioMode_Click" Content="Mode Studio" Style="{StaticResource ObsCommandButtonStyle}"/>
                        <Button x:Name="BtnSettings" Click="BtnSettings_Click" Content="Paramètres" Style="{StaticResource ObsCommandButtonStyle}"/>
                        <Button Content="Quitter" Click="MenuExit_Click" Style="{StaticResource ObsCommandButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. BARRE D'ÉTAT INFÉRIEURE OFFICIELLE OBS STUDIO          -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="{StaticResource ObsHeaderBackground}" BorderBrush="{StaticResource ObsDockBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0" LastChildFill="True">
                <!-- Statut Réseau Gauche (Carré vert santé réseau OBS) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLiveDot" Text="■" FontSize="12" Foreground="#2FE06A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusLive" Text="LIVE: 00:00:00" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ObsTextPrimary}" Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtStatusRec" Text="REC: 00:00:00" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ObsTextPrimary}" Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtStatusCpu" Text="CPU: 1.8%, 60.00 fps" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtStatusFps" Text="60.00 FPS" FontSize="11" Foreground="#2FE06A" Margin="0,0,14,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatusBitrate" Text="Débit: 6000 kb/s" FontSize="11" Foreground="{StaticResource ObsTextSecondary}"/>
                </StackPanel>

                <!-- Infos Réseau / Caméras Droite -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLanBroadcastStatus" Text="LAN: 192.168.1.50:8089" FontSize="11" Foreground="{StaticResource ObsTextSecondary}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtCameraStatusFooter" Text="Téléphones: 0/15" FontSize="11" Foreground="{StaticResource ObsTextMuted}"/>
                    <!-- Champs techniques préservés pour compatibilité code-behind -->
                    <TextBlock x:Name="TxtProgramStatusFooter" Visibility="Collapsed"/><TextBlock x:Name="StatusServerText" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
