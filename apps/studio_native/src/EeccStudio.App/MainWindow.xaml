<Window x:Class="EeccStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECC Studio — Radio &amp; Diffusion Pro (EECC Officiel)" 
        Height="880" Width="1440"
        MinHeight="760" MinWidth="1100"
        Background="#3C4146"
        Icon="Assets/eecc.ico"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/StudioColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Style Boutons Volet Gauche -->
            <Style x:Key="LeftNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8B949E"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A2333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style Boutons Navigation Supérieure (Pills) -->
            <Style x:Key="TopNavPillStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style Bouton Action Transition -->
            <Style x:Key="TransitionBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#161F2E"/>
                <Setter Property="Foreground" Value="#F0F6FC"/>
                <Setter Property="BorderBrush" Value="#253248"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#223046"/>
                                    <Setter Property="BorderBrush" Value="#388BFD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style Boutons Docks OBS -->
            <Style x:Key="DockMiniBtn" TargetType="Button">
                <Setter Property="Background" Value="#161F2E"/>
                <Setter Property="Foreground" Value="#C9D1D9"/>
                <Setter Property="BorderBrush" Value="#253248"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E88E5"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- GRILLE RACINE : VOLET GAUCHE (COLONNE 0) + ESPACE DE TRAVAIL (COLONNE 1) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/> <!-- Volet Navigation Vertical Gauche -->
            <ColumnDefinition Width="*"/>  <!-- Espace Principal Régie Studio -->
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- VOLET DE NAVIGATION VERTICAL GAUCHE                      -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="#3C4146" BorderBrush="#22262B" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,0">
                <!-- 1. Accueil (ACTIF - Fond Bleu Rectangulaire Arrondi) -->
                <Button Margin="6,3" Height="52" Background="#5A6168" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="16" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Accueil" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. Diffusion -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnToggleStream_Click" ToolTip="Diffusion en Direct">
                    <StackPanel>
                        <TextBlock Text="📡" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Diffusion" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 3. Enregistrement -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnToggleRecord_Click" ToolTip="Enregistrement Master">
                    <StackPanel>
                        <TextBlock Text="🔴" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enregistrement" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <!-- 4. Playlists -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="MenuRemux_Click" ToolTip="Playlists et Médias">
                    <StackPanel>
                        <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Playlists" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 5. Médias -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnAddSource_Click" ToolTip="Gestionnaire de Médias">
                    <StackPanel>
                        <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Médias" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 6. Scènes -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnAddScene_Click" ToolTip="Gestionnaire de Scènes">
                    <StackPanel>
                        <TextBlock Text="🎬" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scènes" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 7. Outils -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnPairQr_Click" ToolTip="Outils &amp; QR Code Appairage">
                    <StackPanel>
                        <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Outils" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 8. Paramètres -->
                <Button Style="{StaticResource LeftNavButtonStyle}" Click="BtnSettings_Click" ToolTip="Paramètres Système">
                    <StackPanel>
                        <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Paramètres" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ESPACE DE TRAVAIL PRINCIPAL (RÉGIE BROADCAST)            -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>  <!-- En-Tête Supérieur & Onglets Horizontaux -->
                <RowDefinition Height="*"/>   <!-- Double Écran Studio (Preview & Program) -->
                <RowDefinition Height="255"/> <!-- Docks OBS (Scènes, Sources, Mixeur, Commandes) -->
                <RowDefinition Height="30"/>  <!-- Barre de Statut Inférieure -->
            </Grid.RowDefinitions>

            <!-- 1. EN-TÊTE SUPÉRIEUR & ONGLETS HORIZONTAUX -->
            <Border Grid.Row="0" Background="#62686F" BorderBrush="#22262B" BorderThickness="0,0,0,1" Padding="14,6">
                <DockPanel LastChildFill="True">
                    <!-- A. LOGO & TITRE OFFICIEL GAUCHE -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- Logo Rouge Arrondi avec Croix / Logo EECC Développé -->
                        <Border Width="36" Height="36" CornerRadius="8" Background="#B91C1C" BorderBrush="#EF4444" BorderThickness="1.5" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Image Source="Assets/logo_official.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Fallback élégant si chargement différé -->
                                <TextBlock Text="✝" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="ECC Studio" FontWeight="Black" FontSize="16" Foreground="#FFFFFF"/>
                            <TextBlock Text="Radio &amp; Diffusion Pro" FontSize="10" Foreground="#8B949E" FontWeight="Medium"/>
                            <TextBlock x:Name="BadgeDemo" Text="MODE DÉMO — données d'exemple" Visibility="Collapsed" FontSize="9" FontWeight="Bold" Foreground="#7A1D1D" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- C. CONTRÔLES SUPÉRIEURS DROITE -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Sélecteur d'écran -->
                        <ComboBox Width="135" Height="30" Background="#4A5057" Foreground="#F0F6FC" BorderBrush="#2A2E33" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,8,0">
                            <ComboBoxItem Content="🖥 Écran principal"/>
                            <ComboBoxItem Content="🖥 Moniteur Régie 2"/>
                            <ComboBoxItem Content="📺 Sortie HDMI / SDI"/>
                        </ComboBox>

                        <!-- Badge REC : OFF -->
                        <Border x:Name="BadgeRecIndicator" Background="#1E1317" BorderBrush="#4A1821" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtRecBadge" Text="🔴 REC : OFF" Foreground="#F87171" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Bouton Mode Studio -->
                        <Button Content="🖥 Mode Studio" Background="#4A5057" Foreground="#38BDF8" BorderBrush="#2A2E33" BorderThickness="1" Padding="10,5" Margin="0,0,10,0" FontWeight="Bold" FontSize="11" Click="BtnStudioMode_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Boutons Système Fenêtre (—, ❐, ✕) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="—" Width="26" Height="26" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="1,0" Click="MenuFullscreen_Click"/>
                            <Button Content="❐" Width="26" Height="26" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="1,0" Click="MenuFullscreen_Click"/>
                            <Button Content="✕" Width="26" Height="26" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Margin="1,0" Click="MenuExit_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- B. ONGLETS HORIZONTAUX DU CENTRE (PILLS) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Accueil (Actif) -->
                        <Button Content="🏠 Accueil" Background="#E6E8EB" Foreground="#1C2126" Style="{StaticResource TopNavPillStyle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="🖼 Diffusion" Style="{StaticResource TopNavPillStyle}" Click="BtnToggleStream_Click"/>
                        <Button Content="📹 Médias" Style="{StaticResource TopNavPillStyle}" Click="BtnAddSource_Click"/>
                        <Button Content="🎬 Scènes" Style="{StaticResource TopNavPillStyle}" Click="BtnAddScene_Click"/>
                        <Button Content="🎵 Playlists" Style="{StaticResource TopNavPillStyle}" Click="MenuRemux_Click"/>
                        <Button Content="🔧 Outils" Style="{StaticResource TopNavPillStyle}" Click="BtnPairQr_Click"/>
                        <Button Content="⚙ Paramètres" Style="{StaticResource TopNavPillStyle}" Click="BtnSettings_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. DOUBLE ÉCRAN STUDIO (APERÇU / TRANSITION / PROGRAMME) -->
            <Grid Grid.Row="1" Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColPreview" Width="*"/>   <!-- Écran Gauche Aperçu -->
                    <ColumnDefinition x:Name="ColTransitions" Width="145"/> <!-- Colonne Centrale Transition -->
                    <ColumnDefinition x:Name="ColProgram" Width="*"/>   <!-- Écran Droit Programme -->
                </Grid.ColumnDefinitions>

                <!-- A. ÉCRAN GAUCHE : APERÇU (PREVIEW) - CADRE VERT VIF #00E676 -->
                <Border x:Name="BorderPreview" Grid.Column="0" Background="#000000" BorderBrush="#00E676" BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <!-- Image Sanctuaire Église Réelle (Arrière-Plan Haute Définition) -->
                        <Grid Background="#07080A"><TextBlock Text="Aucun signal" Foreground="#8B9198" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>

                        <Image x:Name="ImgPreviewVideo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Grid x:Name="PanelPreviewSlate">
                            <TextBlock x:Name="TxtPreviewEmpty" Text="Aucune image de téléphone reçue." Foreground="#9CA3AF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"/>
                            <TextBlock x:Name="TxtPreviewMain" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtPreviewOverlay" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Barre Supérieure Aperçu : [ APERÇU (PREVIEW) ] + Icônes -->
                        <Border Background="#CC0A0E17" VerticalAlignment="Top" Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="[ APERÇU (PREVIEW) ]" Foreground="#00E676" FontWeight="Black" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="⛶" Foreground="#8B949E" FontSize="13" Margin="8,0" Cursor="Hand" ToolTip="Plein Écran"/>
                                    <TextBlock Text="⚙" Foreground="#8B949E" FontSize="13" Margin="8,0" Cursor="Hand" ToolTip="Propriétés"/>
                                    <TextBlock Text="📌" Foreground="#8B949E" FontSize="13" Margin="8,0" Cursor="Hand" ToolTip="Verrouiller"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Bandeau Tiers Inférieur Transparent dans l'Aperçu -->
                        <Border Background="#D00A0E17" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="8" Padding="16,8" Margin="0,0,0,16" BorderBrush="#2A2E33" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="👁 " Foreground="#00E676" FontSize="12"/>
                                    <TextBlock x:Name="TxtPreviewSceneName" Text="Scène : Culte Principal" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPreviewSub" Text="Source : Caméra 1 + Média" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- B. COLONNE CENTRALE : COMMANDES DE TRANSITION (OBS MODE STUDIO) -->
                <StackPanel x:Name="PanelTransitions" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                    <TextBlock Text="&gt;&gt; TRANSITION" Foreground="#94A3B8" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Bouton Couper (Bleu Vif #1877F2) -->
                    <Button x:Name="BtnCut" Content="✂   Couper" Background="#1877F2" Foreground="#FFFFFF" FontWeight="Black" FontSize="13" Height="38" Width="125" BorderThickness="0" Margin="0,4" Click="BtnCut_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Bouton Fondu Noir -->
                    <Button Content="🌙  Fondu Noir" Style="{StaticResource TransitionBtnStyle}" Width="125" Click="BtnFadeToBlack_Click"/>

                    <!-- Bouton Fondu Couleur -->
                    <Button Content="🎨  Fondu Couleur" Style="{StaticResource TransitionBtnStyle}" Width="125" Click="BtnFade_Click"/>

                    <!-- Durée de Transition -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,2">
                        <TextBlock Text="⏱ Durée : " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <Border Background="#4A5057" BorderBrush="#2A2E33" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="C  400 ms" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>

                    <!-- Slider de Vitesse / Progression de Transition -->
                    <Slider x:Name="SliderTransition" Width="110" Minimum="100" Maximum="1000" Value="400" Margin="0,4,0,8"/>

                    <!-- Bouton Appliquer -->
                    <Button Content="▶  Appliquer" Style="{StaticResource TransitionBtnStyle}" Width="125" Click="BtnCut_Click"/>
                </StackPanel>

                <!-- C. ÉCRAN DROIT : PROGRAMME (ON AIR) - CADRE ROUGE VIF #FF1744 -->
                <Border Grid.Column="2" Background="#000000" BorderBrush="#FF1744" BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <!-- Image Sanctuaire Église Réelle (Arrière-Plan Haute Définition) -->
                        <Grid Background="#07080A"><TextBlock Text="Aucun signal" Foreground="#8B9198" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>

                        <Image x:Name="ImgProgramVideo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Grid x:Name="PanelProgramSlate">
                            <TextBlock x:Name="TxtProgramEmpty" Text="Aucune image à l'antenne." Foreground="#9CA3AF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"/>
                            <TextBlock x:Name="TxtProgramSceneName" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtProgramMain" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtProgramSub" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtProgramStatusFooter" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Barre Supérieure Programme : 🔴 PROGRAMME (ON AIR) + Badge ON AIR -->
                        <Border Background="#CC0A0E17" VerticalAlignment="Top" Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔴  PROGRAMME (ON AIR)" Foreground="#FF1744" FontWeight="Black" FontSize="12"/>
                                </StackPanel>
                                <Border x:Name="PgmOnAirPill" Visibility="Collapsed" Background="#FF1744" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock Text="((📡)) ON AIR" Foreground="#FFFFFF" FontSize="10" FontWeight="Black"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Bandeau Inférieur Live dans le Programme -->
                        <Border Background="#D00A0E17" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12,0,12,14" CornerRadius="8" Padding="14,8" BorderBrush="#3B1820" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProgramLiveFooter" Text="Aucune image à l'antenne" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtProgramDetails" Text="" Foreground="#FFFFFF" FontSize="13" FontWeight="Black" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. DOCKS MODULAIRES OBS STUDIO (4 COLONNES) -->
            <Border Grid.Row="2" Background="#3C4146" BorderBrush="#22262B" BorderThickness="0,1,0,0" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/> <!-- Dock 1 : Scènes -->
                        <ColumnDefinition Width="240"/> <!-- Dock 2 : Sources -->
                        <ColumnDefinition Width="*"/>   <!-- Dock 3 : Mixeur Audio -->
                        <ColumnDefinition Width="230"/> <!-- Dock 4 : Commandes -->
                    </Grid.ColumnDefinitions>

                    <!-- DOCK 1 : SCÈNES -->
                    <Border Grid.Column="0" Background="#3A3F45" BorderBrush="#22262B" BorderThickness="1" CornerRadius="8" Margin="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <!-- En-tête Dock Scènes -->
                            <DockPanel Grid.Row="0" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="Scènes" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+" Style="{StaticResource DockMiniBtn}" Width="20" Height="20" Margin="4,0" Click="BtnAddScene_Click" ToolTip="Ajouter"/>
                                    <TextBlock Text="⋮" Foreground="#94A3B8" FontSize="14" Margin="4,0" Cursor="Hand" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Liste des Scènes avec Vignettes Visuelles -->
                            <ListBox x:Name="ListScenes" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="ListScenes_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,4" Margin="2,1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38" Height="24" CornerRadius="4" ClipToBounds="True" Background="#1E293B" Margin="0,0,8,0">
                                                    <TextBlock Text="+" Foreground="#8B9198" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="#F0F6FC" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Barre d'outils Scènes -->
                            <Border Grid.Row="2" Background="#32373C" BorderBrush="#22262B" BorderThickness="0,1,0,0" Padding="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="▲" Style="{StaticResource DockMiniBtn}" Click="BtnMoveSceneUp_Click" ToolTip="Monter"/>
                                    <Button Content="▼" Style="{StaticResource DockMiniBtn}" Click="BtnMoveSceneDown_Click" ToolTip="Descendre"/>
                                    <Button Content="📁" Style="{StaticResource DockMiniBtn}" ToolTip="Groupe"/>
                                    <Button Content="🗑" Style="{StaticResource DockMiniBtn}" Click="BtnRemoveScene_Click" ToolTip="Supprimer"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- DOCK 2 : SOURCES -->
                    <Border Grid.Column="1" Background="#3A3F45" BorderBrush="#22262B" BorderThickness="1" CornerRadius="8" Margin="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <!-- En-tête Dock Sources -->
                            <DockPanel Grid.Row="0" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="Sources" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+" Style="{StaticResource DockMiniBtn}" Width="20" Height="20" Margin="4,0" Click="BtnAddSource_Click" ToolTip="Ajouter"/>
                                    <TextBlock Text="⋮" Foreground="#94A3B8" FontSize="14" Margin="4,0" Cursor="Hand" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Liste des Sources avec Œil, Icône, Cadenas, Poignée -->
                            <ListBox x:Name="ListSources" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="ListSources_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,3" LastChildFill="True">
                                            <TextBlock Text="👁" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding IconSymbol}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="🔒" Foreground="#64748B" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="⋮⋮" Foreground="#475569" FontSize="11" Margin="2,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="#F0F6FC" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Barre d'outils Sources -->
                            <Border Grid.Row="2" Background="#32373C" BorderBrush="#22262B" BorderThickness="0,1,0,0" Padding="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="+" Style="{StaticResource DockMiniBtn}" Click="BtnAddSource_Click" ToolTip="Ajouter"/>
                                    <Button Content="📁" Style="{StaticResource DockMiniBtn}" ToolTip="Dossier"/>
                                    <Button Content="⚙" Style="{StaticResource DockMiniBtn}" Click="MenuSourceProperties_Click" ToolTip="Propriétés"/>
                                    <Button Content="🗑" Style="{StaticResource DockMiniBtn}" Click="BtnRemoveSource_Click" ToolTip="Supprimer"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- DOCK 3 : MIXEUR AUDIO MULTI-CANAUX VU-MÈTRES LED RÉELS -->
                    <Border Grid.Column="2" Background="#3A3F45" BorderBrush="#22262B" BorderThickness="1" CornerRadius="8" Margin="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="🔊 Mixeur Audio" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- 5 Tranches de Canaux Audio Stéréo Stables et Fidèles à la Capture -->
                            <UniformGrid Grid.Row="1" Columns="5" Margin="4,0,4,4">
                                <!-- Canal 1 : Master (PGM) -->
                                <Border Background="#32373C" CornerRadius="6" Margin="2" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Master (PGM)" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- VU-Mètre Stéréo LED & Slider Fader -->
                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Barre Gauche L -->
                                            <Border Grid.Column="0" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill1" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <!-- Barre Droite R -->
                                            <Border Grid.Column="1" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill2" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <!-- Fader Slider -->
                                            <Slider Grid.Column="2" x:Name="SliderMaster" Orientation="Vertical" Value="85" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" x:Name="TxtMasterDb" Text="0.0 dB" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Row="3" Content="MUTE" Background="#454B52" Foreground="#94A3B8" BorderBrush="#2A2E33" FontSize="9" FontWeight="Bold" Margin="4,1"/>
                                    </Grid>
                                </Border>

                                <!-- Canal 2 : Micro Pasteur -->
                                <Border Background="#32373C" CornerRadius="6" Margin="2" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Micro Pasteur" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill3" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill4" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Slider Grid.Column="2" Orientation="Vertical" Value="75" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="-6.0 dB" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Row="3" Content="MUTE" Background="#454B52" Foreground="#94A3B8" BorderBrush="#2A2E33" FontSize="9" FontWeight="Bold" Margin="4,1"/>
                                    </Grid>
                                </Border>

                                <!-- Canal 3 : Chœur / Orchestre -->
                                <Border Background="#32373C" CornerRadius="6" Margin="2" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Chœur / Orchestre" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill5" Height="4" VerticalAlignment="Bottom" Background="#F59E0B" CornerRadius="2"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill6" Height="4" VerticalAlignment="Bottom" Background="#F59E0B" CornerRadius="2"/>
                                            </Border>
                                            <Slider Grid.Column="2" Orientation="Vertical" Value="60" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="-12.0 dB" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Row="3" Content="MUTE" Background="#454B52" Foreground="#94A3B8" BorderBrush="#2A2E33" FontSize="9" FontWeight="Bold" Margin="4,1"/>
                                    </Grid>
                                </Border>

                                <!-- Canal 4 : ECC Caméra 1 -->
                                <Border Background="#32373C" CornerRadius="6" Margin="2" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="ECC Caméra 1" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill7" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill8" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Slider Grid.Column="2" Orientation="Vertical" Value="70" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="-8.0 dB" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Row="3" Content="MUTE" Background="#454B52" Foreground="#94A3B8" BorderBrush="#2A2E33" FontSize="9" FontWeight="Bold" Margin="4,1"/>
                                    </Grid>
                                </Border>

                                <!-- Canal 5 : Médias & Vidéo -->
                                <Border Background="#32373C" CornerRadius="6" Margin="2" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Médias &amp; Vidéo" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill9" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#2A2E33" CornerRadius="2" Margin="1">
                                                <Border x:Name="MeterFill10" Height="4" VerticalAlignment="Bottom" Background="#00E676" CornerRadius="2"/>
                                            </Border>
                                            <Slider Grid.Column="2" Orientation="Vertical" Value="65" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="-10.0 dB" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Row="3" Content="MUTE" Background="#454B52" Foreground="#94A3B8" BorderBrush="#2A2E33" FontSize="9" FontWeight="Bold" Margin="4,1"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- DOCK 4 : COMMANDES BROADCAST OFFICIELLES -->
                    <Border Grid.Column="3" Background="#3A3F45" BorderBrush="#22262B" BorderThickness="1" CornerRadius="8" Margin="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="⚙ Commandes" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="8,4" VerticalAlignment="Center">
                                <!-- 1. Démarrer le Streaming (Bleu Vif #1877F2) -->
                                <Button x:Name="BtnToggleStream" Content="▶   Démarrer le Streaming" Background="#1877F2" Foreground="#FFFFFF" FontWeight="Black" FontSize="12" Height="34" Margin="0,3" BorderThickness="0" Click="BtnToggleStream_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 2. Démarrer l'Enregistrement (Rouge Foncé #8B0000) -->
                                <Button x:Name="BtnToggleRecord" Content="🔴   Démarrer l'Enregistrement" Background="#881337" Foreground="#FFFFFF" FontWeight="Black" FontSize="12" Height="34" Margin="0,3" BorderThickness="0" Click="BtnToggleRecord_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 3. Mode Studio : ACTIF (Vert Vif #16A34A) -->
                                <Button x:Name="BtnToggleStudioMode" Content="🖥   Mode Studio : ACTIF" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Black" FontSize="12" Height="34" Margin="0,3" BorderThickness="0" Click="BtnStudioMode_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 4. Instantané -->
                                <Button Content="📷   Instantané" Background="#4A5057" Foreground="#F0F6FC" BorderBrush="#2A2E33" BorderThickness="1" Height="28" Margin="0,3" FontWeight="SemiBold" FontSize="11" Click="BtnPairQr_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 5. Paramètres rapides -->
                                <Button Content="⚡   Paramètres rapides" Background="#4A5057" Foreground="#F0F6FC" BorderBrush="#2A2E33" BorderThickness="1" Height="28" Margin="0,3" FontWeight="SemiBold" FontSize="11" Click="BtnSettings_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. BARRE DE STATUT BROADCAST INFÉRIEURE -->
            <Border Grid.Row="3" Background="#4A5056" BorderBrush="#141C2B" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <!-- Indicateurs Gauche : LIVE, REC, CPU, FPS, DÉBIT, LAN -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- LIVE -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock x:Name="StatusLiveDot" Text="● " Foreground="#5C636A" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatusLive" Text="LIVE  00:00:00" Foreground="#FFFFFF" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>

                        <!-- REC -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="● " Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatusRec" Text="REC  00:00:00" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>

                        <!-- CPU -->
                        <TextBlock x:Name="TxtStatusCpu" Text="CPU : 4.8%" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" Margin="0,0,16,0"/>

                        <!-- FPS -->
                        <TextBlock x:Name="TxtStatusFps" Text="0.00 FPS" Foreground="#8B949E" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Margin="0,0,16,0"/>

                        <!-- Débit -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="🔗 " Foreground="#38BDF8" FontSize="11"/>
                            <TextBlock x:Name="TxtStatusBitrate" Text="Débit : 0.00 Mbps" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>

                        <!-- LAN URL -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="🖥 " Foreground="#38BDF8" FontSize="11"/>
                            <TextBlock x:Name="TxtLanBroadcastStatus" Text="LAN : …" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Contrôle Volume Droit -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔊" Foreground="#94A3B8" FontSize="12" Margin="0,0,6,0"/>
                        <Slider Width="90" Value="80" Minimum="0" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Width="16" Height="10" Background="#2A2E33" CornerRadius="2">
                            <Border Width="12" HorizontalAlignment="Left" Background="#00E676" CornerRadius="2"/>
                        </Border>

                        <!-- Éléments système & statut pour compatibilité code-behind -->
                        <StackPanel Visibility="Collapsed">
                            <Border x:Name="BadgeLiveIndicator">
                                <TextBlock x:Name="TxtLiveBadge" Text="HORS LIGNE"/>
                            </Border>
                            <TextBlock x:Name="StatusServerText" Text="Serveur Prêt"/>
                            <TextBlock x:Name="TxtCameraStatusFooter" Text="Serveur Caméra Actif"/>
                            <Menu>
                                <MenuItem x:Name="MenuStudioModeToggle" IsCheckable="True" IsChecked="True"/>
                            </Menu>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
