<Window x:Class="EeccStudio.QrPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connecter un téléphone — EECC Caméra"
        Height="760" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#3C4146">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="CONNECTER UN TÉLÉPHONE" FontWeight="Black" FontSize="18" Foreground="#FFFFFF"/>
            <TextBlock Text="EECC Caméra · réseau local · jeton à usage unique" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="TxtError" Grid.Row="1" Foreground="#F87171" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="ADRESSE PRIVÉE DU STUDIO" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <ComboBox x:Name="CmbLan" Margin="0,4,0,0" SelectionChanged="CmbLan_SelectionChanged"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="16" Padding="12" HorizontalAlignment="Center" Margin="0,4,0,8">
            <Image x:Name="ImgQrCode" Width="280" Height="280" Stretch="Uniform"
                   SnapsToDevicePixels="True" UseLayoutRounding="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock x:Name="TxtCountdown" Foreground="#38BDF8" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtServerStatus" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="5" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TÉLÉPHONES RELIÉS (limite 15, hors caméras physiques)" Foreground="#8B949E" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtPhones" Foreground="#F0F6FC" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Renouveler" Margin="0,0,6,0" Padding="8,8" Click="BtnRenew_Click"/>
            <Button Grid.Column="1" Content="Copier le code" Margin="3,0,3,0" Padding="8,8" Click="BtnCopy_Click"/>
            <Button Grid.Column="2" Content="Annuler" Margin="6,0,0,0" Padding="8,8" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
