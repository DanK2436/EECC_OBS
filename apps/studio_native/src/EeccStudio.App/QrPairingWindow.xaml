<Window x:Class="EeccStudio.QrPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appairage EECC Caméra — QR Code Local"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#3C4146">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec Logo Officiel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="10" Background="#2A2E33" BorderBrush="#DC2626" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                <Image Source="Assets/logo_official.png" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="APPAIRER EECC CAMÉRA" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Église Évangélique les Cohéritiers du Christ" FontSize="12" Foreground="#C5CCD3" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            
            <Border Background="#16A34A" CornerRadius="12" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtServerStatus" Text="En attente de caméra — port 8089" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Cadre QR Code -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#22262B" BorderThickness="2">
            <Image x:Name="ImgQrCode" Width="260" Height="260" Stretch="Uniform"/>
        </Border>

        <!-- Informations Réseau & Token -->
        <StackPanel Grid.Row="2" Margin="0,16,0,16">
            <Border Background="#32373C" BorderBrush="#22262B" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ADRESSE RÉSEAU DU STUDIO :" Foreground="#C5CCD3" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtIpPort" Text="…" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Copier" Background="#4A5056" Foreground="#F4F6F8" BorderBrush="#22262B" Padding="10,4" Click="BtnCopy_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="Pointez EECC Caméra vers ce code pour vous connecter sans fil." Foreground="#C5CCD3" FontSize="11" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Bouton Fermer -->
        <Button Grid.Row="3" Content="Fermer" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Click="BtnClose_Click"/>
    </Grid>
</Window>
