<Window x:Class="EeccStudio.QrPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appairage EECC Caméra — QR Code Local"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#14151C">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="APPAIRER EECC CAMÉRA" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" CharacterSpacing="100"/>
            <TextBlock Text="Église Évangélique les Cohéritiers du Christ" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            
            <Border Background="#16A34A" CornerRadius="12" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtServerStatus" Text="● Serveur Caméra Actif : Port 8089" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Cadre QR Code -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#30363D" BorderThickness="2">
            <Image x:Name="ImgQrCode" Width="260" Height="260" Stretch="Uniform"/>
        </Border>

        <!-- Informations Réseau & Token -->
        <StackPanel Grid.Row="2" Margin="0,16,0,16">
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ADRESSE RÉSEAU DU STUDIO :" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtIpPort" Text="192.168.1.100:8089" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Copier" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="10,4" Click="BtnCopy_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="Pointez EECC Caméra vers ce code pour vous connecter sans fil." Foreground="#9CA3AF" FontSize="11" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Bouton Fermer -->
        <Button Grid.Row="3" Content="Fermer" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Click="BtnClose_Click"/>
    </Grid>
</Window>
