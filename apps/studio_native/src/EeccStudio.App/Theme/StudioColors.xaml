<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================================== -->
    <!-- THEME OBS STUDIO OFFICIEL (DARK / YAMI) POUR EECC STUDIO                       -->
    <!-- Reproduction fidèle des palettes, surfaces et signaux d'OBS Studio             -->
    <!-- ============================================================================== -->

    <!-- 1. Fonds et Surfaces Principales OBS Studio -->
    <Color x:Key="ObsWindowBackgroundKey">#202225</Color>
    <SolidColorBrush x:Key="ObsWindowBackground" Color="{StaticResource ObsWindowBackgroundKey}" />

    <Color x:Key="ObsDockBackgroundKey">#18191C</Color>
    <SolidColorBrush x:Key="ObsDockBackground" Color="{StaticResource ObsDockBackgroundKey}" />

    <Color x:Key="ObsDockSurfaceKey">#23272A</Color>
    <SolidColorBrush x:Key="ObsDockSurface" Color="{StaticResource ObsDockSurfaceKey}" />

    <Color x:Key="ObsDockBorderKey">#2E3136</Color>
    <SolidColorBrush x:Key="ObsDockBorder" Color="{StaticResource ObsDockBorderKey}" />

    <Color x:Key="ObsHeaderBackgroundKey">#1E1F22</Color>
    <SolidColorBrush x:Key="ObsHeaderBackground" Color="{StaticResource ObsHeaderBackgroundKey}" />

    <!-- 2. Boutons de Commandes OBS Studio (Gris standard avec hover) -->
    <Color x:Key="ObsButtonNormalKey">#36393F</Color>
    <SolidColorBrush x:Key="ObsButtonNormal" Color="{StaticResource ObsButtonNormalKey}" />

    <Color x:Key="ObsButtonHoverKey">#474B53</Color>
    <SolidColorBrush x:Key="ObsButtonHover" Color="{StaticResource ObsButtonHoverKey}" />

    <Color x:Key="ObsButtonPressedKey">#202225</Color>
    <SolidColorBrush x:Key="ObsButtonPressed" Color="{StaticResource ObsButtonPressedKey}" />

    <Color x:Key="ObsButtonBorderKey">#2E3136</Color>
    <SolidColorBrush x:Key="ObsButtonBorder" Color="{StaticResource ObsButtonBorderKey}" />

    <!-- Boutons d'état spécial OBS (Streaming / Rec actif) -->
    <Color x:Key="ObsStreamActiveKey">#E03232</Color>
    <SolidColorBrush x:Key="ObsStreamActive" Color="{StaticResource ObsStreamActiveKey}" />

    <Color x:Key="ObsRecordActiveKey">#E03232</Color>
    <SolidColorBrush x:Key="ObsRecordActive" Color="{StaticResource ObsRecordActiveKey}" />

    <Color x:Key="ObsAccentBlueKey">#2C7BFE</Color>
    <SolidColorBrush x:Key="ObsAccentBlue" Color="{StaticResource ObsAccentBlueKey}" />

    <!-- 3. Feux de Studio Mode (Preview / Program) -->
    <Color x:Key="ObsPreviewGreenKey">#2FE06A</Color>
    <SolidColorBrush x:Key="ObsPreviewGreen" Color="{StaticResource ObsPreviewGreenKey}" />

    <Color x:Key="ObsProgramRedKey">#E03232</Color>
    <SolidColorBrush x:Key="ObsProgramRed" Color="{StaticResource ObsProgramRedKey}" />

    <!-- 4. Typographie OBS Studio -->
    <Color x:Key="ObsTextWhiteKey">#FFFFFF</Color>
    <SolidColorBrush x:Key="ObsTextWhite" Color="{StaticResource ObsTextWhiteKey}" />

    <Color x:Key="ObsTextPrimaryKey">#DCDDDE</Color>
    <SolidColorBrush x:Key="ObsTextPrimary" Color="{StaticResource ObsTextPrimaryKey}" />

    <Color x:Key="ObsTextSecondaryKey">#8E9297</Color>
    <SolidColorBrush x:Key="ObsTextSecondary" Color="{StaticResource ObsTextSecondaryKey}" />

    <Color x:Key="ObsTextMutedKey">#72767D</Color>
    <SolidColorBrush x:Key="ObsTextMuted" Color="{StaticResource ObsTextMutedKey}" />

    <!-- 5. Vu-mètres Audio OBS Studio (Paliers nets sans dégradé) -->
    <SolidColorBrush x:Key="ObsAudioSafe" Color="#2FE06A" />     <!-- -inf à -18 dB (Vert) -->
    <SolidColorBrush x:Key="ObsAudioWarning" Color="#F5A623" />  <!-- -18 dB à -6 dB (Jaune/Ambre) -->
    <SolidColorBrush x:Key="ObsAudioClip" Color="#E03232" />     <!-- -6 dB à 0 dB (Rouge) -->

    <!-- ============================================================================== -->
    <!-- STYLES DE CONTRÔLES COMPATIBLES OBS STUDIO                                    -->
    <!-- ============================================================================== -->

    <!-- Style Bouton de Contrôle OBS (colonne de droite) -->
    <Style x:Key="ObsCommandButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ObsButtonNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource ObsTextWhite}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ObsButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ObsButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style Mini-Bouton d'outils de Dock (+, -, flèches) -->
    <Style x:Key="ObsDockToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ObsButtonNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource ObsTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ObsButtonHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource ObsTextWhite}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style En-Tête de Dock OBS -->
    <Style x:Key="ObsDockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ObsTextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,5"/>
    </Style>

    <!-- Rétro-compatibilité avec les alias précédents -->
    <SolidColorBrush x:Key="ConsoleBackground" Color="{StaticResource ObsWindowBackgroundKey}" />
    <SolidColorBrush x:Key="PanelSurface" Color="{StaticResource ObsDockSurfaceKey}" />
    <SolidColorBrush x:Key="PanelSurfaceElevated" Color="{StaticResource ObsButtonNormalKey}" />
    <SolidColorBrush x:Key="SolidBorder" Color="{StaticResource ObsDockBorderKey}" />
    <SolidColorBrush x:Key="LiveProgramRed" Color="{StaticResource ObsProgramRedKey}" />
    <SolidColorBrush x:Key="PreviewCueGreen" Color="{StaticResource ObsPreviewGreenKey}" />
    <SolidColorBrush x:Key="TextPrimaryCrisp" Color="{StaticResource ObsTextWhiteKey}" />
    <SolidColorBrush x:Key="TextSecondaryMuted" Color="{StaticResource ObsTextSecondaryKey}" />
    <SolidColorBrush x:Key="AudioMeterSafe" Color="#2FE06A" />
    <SolidColorBrush x:Key="AudioMeterWarning" Color="#F5A623" />
    <SolidColorBrush x:Key="AudioMeterClip" Color="#E03232" />

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ObsTextPrimary}"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#2A2E33"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#1F4B99"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ObsDockBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource ObsTextWhite}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsDockBorder}"/>
        <Setter Property="CaretBrush" Value="White"/>
    </Style>
</ResourceDictionary>
